# Required for generated chatbot answers. Never commit real credentials.
NIM_API_KEY=replace-with-your-nvidia-nim-api-key

# Optional; defaults are documented in src/pages/api/chat.ts.
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
# TEASE_MODEL=nvidia/nemotron-3-super-120b-a12b
# RATE_LIMIT_MAX_MESSAGES=10
# Set a unique random value in local and production environments.
# GUARD_SALT=replace-with-a-long-random-secret

# Optional CTF gate. Keep the real flag out of Git.
# Set it in Vercel production before announcing the challenge.
# CTF_FLAG=flag{replace-with-your-private-flag}
