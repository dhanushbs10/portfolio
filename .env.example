# Required for the Ping AI chat assistant (route handler at src/app/api/chat/route.ts)
NVIDIA_API_KEY="nvapi-..."

# Optional: separate key for the safety classifier. Falls back to NVIDIA_API_KEY when unset.
NVIDIA_API_KEY_GUARD=""

# Optional chat rate limiting (per IP, in-memory). Defaults: 40 messages / 0.25 hours.
RATE_LIMIT_MAX_MESSAGES=40
RATE_LIMIT_WINDOW_HOURS=0.25