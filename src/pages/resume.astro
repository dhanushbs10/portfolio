---
import Doc from "../layouts/Doc.astro";
---

<Doc title="Resume" active="resume" description="Resume and detailed CV — Dhanush B S">
  <section class="mx-auto max-w-7xl px-5 pt-32 pb-20 md:px-8 md:pt-40">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="meta-label">Dossier — resume</p>
        <h1 class="display mt-3 text-5xl md:text-7xl">Resume & CV.</h1>
        <p class="mt-4 max-w-2xl text-[var(--color-ink-3)]">Resume and detailed CV will appear here. No download — embedded for recruiters.</p>
      </div>
      <div class="flex rounded-full border border-[var(--color-line-strong)] bg-[var(--color-card)] p-1">
        <button id="btn-resume" class="rounded-full bg-[var(--color-ink)] px-6 py-2 font-mono text-xs font-semibold text-[var(--color-paper)] transition-colors">Resume</button>
        <button id="btn-cv" class="rounded-full px-6 py-2 font-mono text-xs font-semibold text-[var(--color-ink-2)] transition-colors hover:text-[var(--color-ink)]">Detailed CV</button>
      </div>
    </div>

    <!-- Resume — blank placeholder, you will provide PDF location later -->
    <div id="view-resume" class="mt-12">
      <div class="dossier flex min-h-[520px] items-center justify-center p-12 text-center">
        <div>
          <p class="font-mono text-xs tracking-[0.18em] text-[var(--color-ink-3)]">RESUME — PLACEHOLDER</p>
          <p class="mt-4 text-sm text-[var(--color-ink-3)]">You will tell me where the resume PDF is located. This area is kept blank and will embed the PDF.</p>
          <p class="mt-2 font-mono text-xs text-[var(--color-ink-3)]">No download link — full inline display as requested.</p>
        </div>
      </div>
    </div>

    <!-- Detailed CV — blank placeholder -->
    <div id="view-cv" class="mt-12 hidden">
      <div class="dossier flex min-h-[520px] items-center justify-center p-12 text-center">
        <div>
          <p class="font-mono text-xs tracking-[0.18em] text-[var(--color-ink-3)]">DETAILED CV — PLACEHOLDER</p>
          <p class="mt-4 text-sm text-[var(--color-ink-3)]">You will tell me where the detailed CV PDF is located. Recruiter clicks “Detailed CV” to see this view.</p>
          <p class="mt-2 font-mono text-xs text-[var(--color-ink-3)]">Kept blank for now.</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    const btnR = document.getElementById('btn-resume');
    const btnC = document.getElementById('btn-cv');
    const viewR = document.getElementById('view-resume');
    const viewC = document.getElementById('view-cv');
    function show(which) {
      const isResume = which === 'resume';
      viewR.classList.toggle('hidden', !isResume);
      viewC.classList.toggle('hidden', isResume);
      btnR.className = isResume ? 'rounded-full bg-[var(--color-ink)] px-6 py-2 font-mono text-xs font-semibold text-[var(--color-paper)] transition-colors' : 'rounded-full px-6 py-2 font-mono text-xs font-semibold text-[var(--color-ink-2)] transition-colors hover:text-[var(--color-ink)]';
      btnC.className = !isResume ? 'rounded-full bg-[var(--color-ink)] px-6 py-2 font-mono text-xs font-semibold text-[var(--color-paper)] transition-colors' : 'rounded-full px-6 py-2 font-mono text-xs font-semibold text-[var(--color-ink-2)] transition-colors hover:text-[var(--color-ink)]';
    }
    btnR?.addEventListener('click', () => show('resume'));
    btnC?.addEventListener('click', () => show('cv'));
  </script>
</Doc>
