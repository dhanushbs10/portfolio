---
import Doc from "../layouts/Doc.astro";
import { profile } from "../data/profile";
import { projects } from "../data/projects";
---

<Doc title="Resume" active="resume" description="Resume and detailed CV — Dhanush B S">
  <section class="mx-auto max-w-7xl px-5 pt-32 pb-20 md:px-8 md:pt-40">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="meta-label">Dossier — resume</p>
        <h1 class="display mt-3 text-5xl md:text-7xl">Resume & CV.</h1>
        <p class="mt-4 max-w-2xl text-[var(--color-ink-3)]">Recruiters see the concise resume first. Need the full story — switch to Detailed CV.</p>
      </div>
      <div class="flex rounded-full border border-[var(--color-line-strong)] bg-[var(--color-card)] p-1">
        <button id="btn-resume" class="rounded-full bg-[var(--color-ink)] px-6 py-2 font-mono text-xs font-semibold text-[var(--color-paper)] transition-colors">Resume</button>
        <button id="btn-cv" class="rounded-full px-6 py-2 font-mono text-xs font-semibold text-[var(--color-ink-2)] transition-colors hover:text-[var(--color-ink)]">Detailed CV</button>
      </div>
    </div>

    <!-- Resume — concise one page -->
    <div id="view-resume" class="mt-12">
      <div class="dossier overflow-hidden">
        <div class="border-b border-[var(--color-line)] bg-[var(--color-card-2)] p-8 md:p-10">
          <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
            <div>
              <h2 class="display text-3xl md:text-4xl">{profile.name}</h2>
              <p class="mt-2 font-mono text-xs tracking-[0.16em] text-[var(--color-ink-3)]">{profile.role} — {profile.focus}</p>
              <p class="mt-3 max-w-xl text-sm leading-relaxed text-[var(--color-ink-2)]">{profile.intro}</p>
            </div>
            <div class="shrink-0 font-mono text-xs leading-relaxed text-[var(--color-ink-3)]">
              <div>{profile.location}</div>
              <div>{profile.contact.email}</div>
              <div>{profile.contact.phone}</div>
              <div class="mt-2 flex gap-3">
                <a href={profile.contact.github} target="_blank" class="underline hover:text-[var(--color-ink)]">GitHub</a>
                <a href={profile.contact.linkedin} target="_blank" class="underline hover:text-[var(--color-ink)]">LinkedIn</a>
              </div>
            </div>
          </div>
        </div>
        <div class="grid gap-8 p-8 md:grid-cols-[1.4fr_0.9fr] md:p-10">
          <div class="space-y-8">
            <div>
              <h3 class="font-mono text-xs tracking-[0.18em] text-[var(--color-ink-3)]">EDUCATION</h3>
              {profile.education.map((e) => (
                <div class="mt-4">
                  <p class="font-semibold text-[var(--color-ink)]">{e.school}</p>
                  <p class="text-sm text-[var(--color-ink-3)]">{e.place} — {e.period}</p>
                  <ul class="mt-2 list-disc pl-5 text-sm text-[var(--color-ink-2)]">
                    {e.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                </div>
              ))}
            </div>
            <div>
              <h3 class="font-mono text-xs tracking-[0.18em] text-[var(--color-ink-3)]">SELECTED PROJECTS</h3>
              <div class="mt-4 space-y-4">
                {projects.slice(0,3).map((p) => (
                  <div class="rounded-xl border border-[var(--color-line)] p-4">
                    <p class="font-mono text-xs text-[var(--color-accent-ink)]">{p.category.toUpperCase()}</p>
                    <p class="font-semibold text-[var(--color-ink)]">{p.title} — {p.tagline}</p>
                    <p class="mt-1 text-sm text-[var(--color-ink-3)]">{p.description.slice(0,140)}…</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
          <div class="space-y-8">
            <div>
              <h3 class="font-mono text-xs tracking-[0.18em] text-[var(--color-ink-3)]">CORE SKILLS</h3>
              <div class="mt-4 space-y-3">
                {profile.coreSkills.map((s) => (
                  <div>
                    <p class="text-sm font-semibold text-[var(--color-ink)]">{s.title}</p>
                    <p class="text-xs leading-relaxed text-[var(--color-ink-3)]">{s.tools.join(" · ")}</p>
                  </div>
                ))}
              </div>
            </div>
            <div>
              <h3 class="font-mono text-xs tracking-[0.18em] text-[var(--color-ink-3)]">EXPERIENCE SNAPSHOT</h3>
              <div class="mt-4 space-y-3">
                {profile.journey.slice(0,3).map((j) => (
                  <div class="border-l-2 border-[var(--color-line)] pl-3">
                    <p class="text-sm font-semibold text-[var(--color-ink)]">{j.title}</p>
                    <p class="font-mono text-xs text-[var(--color-ink-3)]">{j.org} — {j.period}</p>
                  </div>
                ))}
              </div>
            </div>
            <div>
              <h3 class="font-mono text-xs tracking-[0.18em] text-[var(--color-ink-3)]">CERTIFICATIONS</h3>
              <p class="mt-3 text-sm text-[var(--color-ink-2)]">{profile.certifications[0].title} — {profile.certifications[0].org} <span class="tag ml-2 !py-1 text-xs">{profile.certifications[0].status}</span></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Detailed CV — full -->
    <div id="view-cv" class="mt-12 hidden">
      <div class="dossier overflow-hidden">
        <div class="border-b border-[var(--color-line)] bg-[var(--color-card-2)] p-8 md:p-10">
          <h2 class="display text-3xl">Detailed Curriculum Vitae</h2>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-[var(--color-ink-3)]">Full dossier — every project opened, every discipline, full timeline. Same data as the 7 case files, presented as a classic CV for recruiters who want depth.</p>
        </div>
        <div class="p-8 md:p-10 space-y-10">
          <div>
            <h3 class="display text-xl">All Projects — Case Files</h3>
            <div class="mt-6 grid gap-4 md:grid-cols-2">
              {projects.map((p) => (
                <a href={`/work/${p.slug}`} class="dossier p-5 hover:border-[var(--color-line-strong)]">
                  <p class="font-mono text-xs tracking-[0.16em] text-[var(--color-accent-ink)]">{p.category.toUpperCase()} — {p.index}</p>
                  <p class="mt-2 font-semibold text-[var(--color-ink)]">{p.title}</p>
                  <p class="mt-1 text-sm text-[var(--color-ink-3)]">{p.tagline}</p>
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {p.stack.slice(0,4).map((t) => <span class="tag !py-1 text-xs">{t}</span>)}
                  </div>
                </a>
              ))}
            </div>
          </div>
          <div class="grid gap-8 md:grid-cols-2">
            <div>
              <h3 class="display text-xl">Education</h3>
              <div class="mt-4 space-y-4">
                {profile.education.map((e) => (
                  <div class="rounded-xl border border-[var(--color-line)] p-4">
                    <p class="font-semibold">{e.school}</p>
                    <p class="text-sm text-[var(--color-ink-3)]">{e.place} — {e.period}</p>
                    <ul class="mt-2 list-disc pl-5 text-sm text-[var(--color-ink-2)]">{e.points.map(pt => <li>{pt}</li>)}</ul>
                  </div>
                ))}
              </div>
            </div>
            <div>
              <h3 class="display text-xl">Journey</h3>
              <div class="mt-4 space-y-3">
                {profile.journey.map((j) => (
                  <div class="rounded-xl border border-[var(--color-line)] p-4">
                    <p class="font-semibold text-[var(--color-ink)]">{j.title}</p>
                    <p class="font-mono text-xs text-[var(--color-ink-3)]">{j.org} — {j.period}</p>
                    <p class="mt-2 text-sm text-[var(--color-ink-3)]">{j.desc}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
          <div>
            <h3 class="display text-xl">Disciplines & Tools</h3>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              {profile.coreSkills.map((s) => (
                <div class="dossier p-5">
                  <p class="font-semibold">{s.title}</p>
                  <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-3)]">{s.tools.join(" · ")}</p>
                </div>
              ))}
            </div>
          </div>
          <div>
            <h3 class="display text-xl">Interests</h3>
            <div class="mt-4 grid gap-3 sm:grid-cols-3">
              {profile.interests.map((it) => (
                <div class="rounded-xl border border-[var(--color-line)] p-4">
                  <p class="font-semibold text-sm">{it.title}</p>
                  <p class="mt-1 text-xs leading-relaxed text-[var(--color-ink-3)]">{it.desc}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const btnR = document.getElementById('btn-resume');
    const btnC = document.getElementById('btn-cv');
    const viewR = document.getElementById('view-resume');
    const viewC = document.getElementById('view-cv');
    function show(which) {
      const isResume = which === 'resume';
      viewR.classList.toggle('hidden', !isResume);
      viewC.classList.toggle('hidden', isResume);
      btnR.className = isResume ? 'rounded-full bg-[var(--color-ink)] px-6 py-2 font-mono text-xs font-semibold text-[var(--color-paper)] transition-colors' : 'rounded-full px-6 py-2 font-mono text-xs font-semibold text-[var(--color-ink-2)] transition-colors hover:text-[var(--color-ink)]';
      btnC.className = !isResume ? 'rounded-full bg-[var(--color-ink)] px-6 py-2 font-mono text-xs font-semibold text-[var(--color-paper)] transition-colors' : 'rounded-full px-6 py-2 font-mono text-xs font-semibold text-[var(--color-ink-2)] transition-colors hover:text-[var(--color-ink)]';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    btnR?.addEventListener('click', () => show('resume'));
    btnC?.addEventListener('click', () => show('cv'));
  </script>
</Doc>
