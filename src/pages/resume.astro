---
import Doc from "../layouts/Doc.astro";
import CvDoc from "../components/CvDoc.astro";
---
<style is:global>
  /* Resume page — no top blur (display:none, list-page normal) */
  body:has(#view-cv) #top-blur { display: none !important; }
</style>

<Doc title="Resume" active="resume" description="Resume and detailed CV — Dhanush B S">
  <section class="mx-auto max-w-7xl px-5 pt-32 pb-20 md:px-8 md:pt-40">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="meta-label">Dossier — resume</p>
        <h1 class="display mt-3 text-5xl md:text-7xl">Resume & CV.</h1>
        <p class="mt-4 max-w-2xl text-[var(--color-ink-3)]">One-page summary and a full detailed CV — same facts, every project opened.</p>
      </div>
      <div class="flex rounded-full border border-[var(--color-line-strong)] bg-[var(--color-card)] p-1">
        <button id="btn-resume" class="rounded-full bg-[var(--color-ink)] px-6 py-2 font-mono text-xs font-semibold text-[var(--color-paper)] transition-colors">Resume</button>
        <button id="btn-cv" class="rounded-full px-6 py-2 font-mono text-xs font-semibold text-[var(--color-ink-2)] transition-colors hover:text-[var(--color-ink)]">Detailed CV</button>
      </div>
    </div>

    <!-- Resume — plain image, no iframe toolbar -->
    <div id="view-resume" class="mt-12">
      <div class="mx-auto max-w-[860px] bg-white p-3 shadow-[0_20px_60px_rgba(0,0,0,0.35)] md:p-4">
        <img src="/resume/page-1.png" alt="Resume — Dhanush B S" class="w-full" loading="eager" />
      </div>
      <div class="mx-auto mt-6 flex max-w-[860px] justify-center gap-3">
        <a href="/Dhanush_BS_Resume.pdf" download class="btn-ink !px-5 !py-2.5 text-xs">Download PDF ↗</a>
        <a href="/Dhanush_BS_Resume.pdf" target="_blank" class="btn-line !px-5 !py-2.5 text-xs">Open PDF ↗</a>
      </div>
    </div>

    <!-- Detailed CV — full document rendered from the same facts as the resume -->
    <div id="view-cv" class="mt-12 hidden">
      <div class="mx-auto mb-5 flex max-w-[860px] items-center justify-between gap-3">
        <p class="font-mono text-[0.66rem] tracking-[0.16em] text-[var(--color-ink-3)]">RECOMMEND: SAVE AS PDF FOR A-STYLE SHARING</p>
        <button id="btn-print-cv" class="btn-line !px-5 !py-2 text-xs">Print / Save as PDF</button>
      </div>
      <CvDoc />
    </div>
  </section>

  <script>
    const btnR = document.getElementById('btn-resume');
    const btnC = document.getElementById('btn-cv');
    const viewR = document.getElementById('view-resume');
    const viewC = document.getElementById('view-cv');
    const btnP = document.getElementById('btn-print-cv');
    const active = 'rounded-full bg-[var(--color-ink)] px-6 py-2 font-mono text-xs font-semibold text-[var(--color-paper)] transition-colors';
    const idle = 'rounded-full px-6 py-2 font-mono text-xs font-semibold text-[var(--color-ink-2)] transition-colors hover:text-[var(--color-ink)]';
    function show(which) {
      const isResume = which === 'resume';
      viewR.classList.toggle('hidden', !isResume);
      viewC.classList.toggle('hidden', isResume);
      btnR.className = isResume ? active : idle;
      btnC.className = !isResume ? active : idle;
    }
    btnR?.addEventListener('click', () => show('resume'));
    btnC?.addEventListener('click', () => show('cv'));
    btnP?.addEventListener('click', () => window.print());
  </script>
</Doc>