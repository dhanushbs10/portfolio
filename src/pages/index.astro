---
import Doc from "../layouts/Doc.astro";
import { profile } from "../data/profile";
import { projects } from "../data/projects";

const ticker = ["CYBERSECURITY", "NETWORKING", "LINUX", "WIRESHARK", "NMAP", "BURP SUITE", "TCP/IP", "PYTHON", "PACKET TRACER", "HOME LAB", "ETHERNET", "METASPLOIT"];

const gradients = ["project-accent-1","project-accent-2","project-accent-3","project-accent-4","project-accent-5","project-accent-6","project-accent-7"];

const stats = [
  { value: "7", label: "Projects shipped" },
  { value: "5", label: "Languages used" },
  { value: "3", label: "Networking labs" },
  { value: "100%", label: "Open-source" },
];
---

<Doc>
  <!-- Hero -->
  <section class="hero-mask blueprint relative overflow-hidden pt-32 pb-20 md:pt-44 md:pb-32">
    <div class="relative mx-auto max-w-7xl px-5 md:px-8">
      <!-- File metadata strip -->
      <div class="reveal flex flex-wrap items-center gap-x-6 gap-y-2 border-y border-[var(--color-line-strong)] py-3 font-mono text-[0.68rem] tracking-[0.2em] text-[var(--color-ink-2)]">
        <span>FILE — PORTFOLIO</span>
        <span>SUBJECT — {profile.name.toUpperCase()}</span>
        <span class="ml-auto hidden sm:inline">STATUS — OPEN TO INTERNSHIPS</span>
      </div>

      <!-- Main heading — massive -->
      <h1 class="reveal display mt-10 text-[clamp(3.5rem,11vw,8.5rem)] leading-[0.88]" style="--rd:80ms">
        Dhanush<br />B S<span class="text-gradient">.</span>
      </h1>

      <!-- Two-column: intro + dossier -->
      <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_340px] lg:items-end">
        <div class="reveal" style="--rd:160ms">
          <p class="font-serif text-xl italic leading-relaxed text-[var(--color-ink)] md:text-2xl">
            "{profile.intro}"
          </p>
          <p class="mt-5 max-w-xl text-[0.92rem] leading-[1.85] text-[var(--color-ink-2)]">
            {profile.bio[0]}
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/work" class="btn-ink" data-magnetic>Open the work <span aria-hidden="true">→</span></a>
            <a href="/contact" class="btn-line" data-magnetic>Contact</a>
          </div>
        </div>

        <dl class="reveal dossier divide-y divide-[var(--color-line)] p-2 glow-accent" style="--rd:240ms">
          {[
            ["Focus", "Cybersecurity"],
            ["Pathway", "Diploma CSE · Sem 5"],
            ["Base", profile.location],
            ["Goal", "Network Engineer"],
          ].map(([k, v], i) => (
            <div class="flex items-center justify-between gap-4 px-4 py-3.5">
              <dt class="meta-label">{k}</dt>
              <dd class="text-right text-sm font-semibold">{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Ticker -->
  <div class="overflow-hidden border-y border-[var(--color-line-strong)] bg-[var(--color-ink)] py-3.5 text-[var(--color-paper)]">
    <div class="animate-ticker flex gap-10 font-mono text-[0.7rem] tracking-[0.22em] opacity-90">
      {[...ticker, ...ticker].map((t) => <span class="flex items-center gap-10">{t}<span class="text-[#7d8bff]">·</span></span>)}
    </div>
  </div>

  <!-- Quick stats strip -->
  <section class="border-b border-[var(--color-line)] bg-[var(--color-card)]">
    <div class="mx-auto grid max-w-7xl grid-cols-2 divide-x divide-[var(--color-line)] md:grid-cols-4">
      {stats.map((s, i) => (
        <div class={`reveal px-5 py-8 text-center md:px-8 md:py-10`} style={`--rd:${i * 60}ms`}>
          <p class="stat-num text-3xl text-[var(--color-ink)] md:text-4xl">{s.value}</p>
          <p class="mt-2 font-mono text-[0.64rem] tracking-[0.16em] text-[var(--color-ink-3)]">{s.label.toUpperCase()}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Selected work — horizontal rail -->
  <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-28">
    <div class="reveal flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="meta-label">01 — Selected work</p>
        <h2 class="display mt-3 text-4xl md:text-6xl">Seven builds,<br />each opened fully.</h2>
      </div>
      <a href="/work" class="btn-line !py-2.5" data-magnetic>All work →</a>
    </div>

    <div class="reveal rail mt-12" style="--rd:120ms">
      {projects.map((p, i) => (
        <a href={`/work/${p.slug}`} class="dossier dossier-hover group flex flex-col p-7" data-magnetic>
          {/* Accent bar */}
          <div class={`mb-5 h-1.5 w-12 rounded-full ${gradients[i]} opacity-80 transition-all duration-500 group-hover:w-20`}></div>
          <div class="flex items-center justify-between font-mono text-[0.68rem] tracking-[0.18em]">
            <span class="text-[var(--color-accent-ink)]">{p.index} / {p.category.toUpperCase()}</span>
            <span class="tag !border-emerald-600/40 !text-emerald-700">● LIVE DEMO</span>
          </div>
          <h3 class="display mt-5 text-3xl leading-none transition-colors duration-300 group-hover:text-[var(--color-accent-ink)]">{p.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-2)]">{p.tagline}</p>
          <div class="mt-5 flex flex-wrap gap-1.5">
            {p.stack.slice(0, 4).map((t) => <span class="tag">{t}</span>)}
          </div>
          <span class="mt-auto pt-6 font-mono text-xs text-[var(--color-ink-3)] transition-colors duration-300 group-hover:text-[var(--color-accent-ink)]">READ CASE FILE →</span>
        </a>
      ))}
    </div>
    <p class="reveal mt-2 font-mono text-[0.68rem] tracking-[0.14em] text-[var(--color-ink-3)]">← DRAG TO BROWSE →</p>
  </section>

  <!-- Featured project deep dive -->
  <section class="border-y border-[var(--color-line-strong)] bg-[var(--color-card)]">
    <div class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-28">
      <p class="reveal meta-label">02 — Featured</p>
      <h2 class="reveal display mt-3 text-4xl md:text-6xl">Deep dive: PhantomSection.</h2>
      <p class="reveal mt-4 max-w-2xl text-[var(--color-ink-2)]" style="--rd:80ms">
        A C++ shellcode loader that walks the PEB, parses export address tables, and patches ETW — without touching a single documented API.
      </p>
      <div class="reveal mt-10 grid gap-6 lg:grid-cols-2" style="--rd:160ms">
        <!-- Flow preview -->
        <div class="console">
          <div class="console-bar">
            <i style="background:#f87171"></i><i style="background:#fbbf24"></i><i style="background:#34d399"></i>
            <span class="ml-2">EXECUTION FLOW — 6 STEPS</span>
          </div>
          <div class="console-body space-y-2">
            {projects[0].flow.slice(0, 4).map((f) => (
              <div class="flex gap-3">
                <span class="c-info font-semibold">{f.step}</span>
                <span>{f.title} — <span class="c-dim">{f.detail.slice(0, 60)}…</span></span>
              </div>
            ))}
            <div class="c-dim mt-2">… 2 more steps → full case file</div>
          </div>
        </div>
        <!-- MITRE table -->
        <div class="overflow-hidden rounded-2xl border border-[var(--color-line-strong)] bg-[var(--color-card)] p-6">
          <p class="meta-label">MITRE ATT&CK</p>
          <table class="spec-table mt-4">
            <thead><tr><th>Technique</th><th>Description</th></tr></thead>
            <tbody>
              {projects[0].tables[0].table.rows.map((r) => (
                <tr><td>{r[0]}</td><td>{r[1]}</td></tr>
              ))}
            </tbody>
          </table>
          <a href="/work/phantomsection" class="go-ghost mt-5">Open case file →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Disciplines -->
  <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-28">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr]">
      <div>
        <p class="reveal meta-label">03 — Disciplines</p>
        <h2 class="reveal display mt-3 text-4xl md:text-5xl">Where I<br />operate.</h2>
        <p class="reveal mt-5 max-w-md text-[var(--color-ink-2)]" style="--rd:80ms">
          From packet-level analysis to full-stack builds — the toolkit covers security, networking, systems, and development.
        </p>
      </div>
      <div class="space-y-0 overflow-hidden rounded-2xl border border-[var(--color-line-strong)]" style="--rd:160ms">
        {profile.coreSkills.map((s, i) => (
          <div class={`reveal grid gap-3 p-6 md:grid-cols-[200px_1fr] md:p-7 ${i > 0 ? "border-t border-[var(--color-line)]" : ""}`} style={`--rd:${i * 70}ms`}>
            <h3 class="display text-xl">{s.title}</h3>
            <div class="flex flex-wrap gap-2 content-start">{s.tools.map((t) => <span class="tag">{t}</span>)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Journey timeline -->
  <section class="border-y border-[var(--color-line-strong)] bg-[var(--color-card)]">
    <div class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-28">
      <p class="reveal meta-label">04 — Journey</p>
      <h2 class="reveal display mt-3 text-4xl md:text-6xl">Built by breaking things.</h2>
      <ol class="mt-12">
        {profile.journey.map((j, i) => (
          <li class={`reveal grid gap-2 py-7 md:grid-cols-[180px_240px_1fr] md:gap-8 ${i > 0 ? "border-t border-[var(--color-line)]" : "border-t border-[var(--color-line-strong)]"}`} style={`--rd:${i * 70}ms`}>
            <span class="font-mono text-xs text-[var(--color-ink-3)]">{j.period}</span>
            <div>
              <h3 class="display text-xl">{j.title}</h3>
              <p class="font-mono text-[0.7rem] text-[var(--color-accent-ink)]">{j.org}</p>
            </div>
            <p class="text-sm leading-relaxed text-[var(--color-ink-2)]">{j.desc}</p>
          </li>
        ))}
      </ol>
      <div class="reveal mt-10 flex flex-wrap gap-4">
        <a href="/overview" class="btn-line" data-magnetic>Full overview →</a>
        <a href="/contact" class="btn-ink" data-magnetic>Start a conversation →</a>
      </div>
    </div>
  </section>
</Doc>
