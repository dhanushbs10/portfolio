---
import Doc from "../layouts/Doc.astro";
import { profile } from "../data/profile";
import { projects } from "../data/projects";

const ticker = ["CYBERSECURITY", "NETWORKING", "LINUX", "WIRESHARK", "NMAP", "BURP SUITE", "TCP/IP", "PYTHON", "PACKET TRACER", "HOME LAB", "ETHERNET", "METASPLOIT"];

const stats = [
  { value: "7", label: "Projects shipped" },
  { value: "5", label: "Languages used" },
  { value: "3", label: "Networking labs" },
  { value: "100%", label: "Open-source" },
];
---

<Doc>
  <!-- Hero -->
  <section class="blueprint relative overflow-hidden pt-32 pb-16 md:pt-44 md:pb-24">
    <div class="aurora"></div>

    <div class="relative mx-auto max-w-7xl px-5 md:px-8">
      <!-- Main heading - character assembly (Stefan Vitasović-style) -->
      <h1 id="hero-title" class="display mt-10 text-[clamp(3.5rem,11vw,8.5rem)] leading-[0.88]" aria-label="Dhanush B S.">
        <span class="char-row"><span class="char-wrap"><span class="char" style="--i:0">D</span><span class="char" style="--i:1">h</span><span class="char" style="--i:2">a</span><span class="char" style="--i:3">n</span><span class="char" style="--i:4">u</span><span class="char" style="--i:5">s</span><span class="char" style="--i:6">h</span></span></span><br />
        <span class="char-row"><span class="char-wrap"><span class="char" style="--i:7">B</span><span class="char" style="--i:8">S</span><span class="char" style="--i:9"><span class="text-[var(--color-accent)]">.</span></span></span></span>
      </h1>

      <!-- Two-column: intro + dossier -->
      <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_340px] lg:items-end">
        <div class="reveal" style="--rd:160ms">
          <p class="font-serif text-xl italic leading-relaxed text-[var(--color-ink-2)] md:text-2xl">
            "{profile.intro}"
          </p>
          <p class="mt-5 max-w-xl text-[0.92rem] leading-[1.85] text-[var(--color-ink-3)]">
            {profile.bio[0]}
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/work" class="btn-ink" data-magnetic>Open the work <span aria-hidden="true">→</span></a>
            <a href="/contact" class="btn-line" data-magnetic>Contact</a>
          </div>
        </div>

        <dl class="reveal dossier divide-y divide-[var(--color-line)] p-2" style="--rd:240ms">
          {[
            ["Focus", "Cybersecurity"],
            ["Pathway", "Diploma CSE · Sem 5"],
            ["Base", profile.location],
            ["Goal", "Network Engineer"],
          ].map(([k, v]) => (
            <div class="flex items-center justify-between gap-4 px-4 py-3.5">
              <dt class="meta-label">{k}</dt>
              <dd class="text-right text-sm font-semibold text-[var(--color-ink)]">{v}</dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- Scroll hint -->
      <div class="reveal mt-16 flex items-center gap-4 font-mono text-[0.66rem] tracking-[0.24em] text-[var(--color-ink-3)]" style="--rd:280ms">
        <span class="inline-block h-8 w-px bg-[var(--color-line-strong)]"></span>
        SCROLL TO EXPLORE
      </div>
    </div>
  </section>

  <!-- Ticker -->
  <div class="overflow-hidden border-y border-[var(--color-line-strong)] bg-[var(--color-night)] py-3.5 text-[var(--color-ink)]">
    <div class="animate-ticker flex gap-10 font-mono text-[0.7rem] tracking-[0.22em] opacity-80">
      {[...ticker, ...ticker].map((t) => <span class="flex items-center gap-10">{t}<span class="text-[var(--color-accent)]">·</span></span>)}
    </div>
  </div>

  <!-- Quick stats strip -->
  <section class="border-b border-[var(--color-line)]">
    <div class="mx-auto grid max-w-7xl grid-cols-2 divide-x divide-[var(--color-line)] md:grid-cols-4">
      {stats.map((s, i) => (
        <div class="reveal px-5 py-8 text-center md:px-8 md:py-10" style={`--rd:${i * 60}ms`}>
          <p class="stat-num text-3xl text-[var(--color-ink)] md:text-4xl">{s.value}</p>
          <p class="mt-2 font-mono text-[0.64rem] tracking-[0.16em] text-[var(--color-ink-3)]">{s.label.toUpperCase()}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Selected work - horizontal rail -->
  <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-28">
    <div class="reveal flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="meta-label">01 - Selected work</p>
        <h2 class="display mt-3 text-4xl md:text-6xl">Seven builds,<br />each opened fully.</h2>
      </div>
      <a href="/work" class="btn-line !py-2.5" data-magnetic>All work →</a>
    </div>

    <div class="reveal rail mt-12" id="work-rail" style="--rd:120ms">
      {projects.map((p, i) => (
        <a href={`/work/${p.slug}`} class="dossier dossier-hover group flex flex-col p-7" data-magnetic>
          <div class="flex items-baseline justify-between gap-4 font-mono text-[0.68rem] tracking-[0.18em]">
            <span class="display text-[1.6rem] font-bold tracking-tight text-[var(--color-ink-3)] transition-colors duration-300 group-hover:text-[var(--color-ink)]">{p.index}</span>
            <span class="text-[var(--color-accent-ink)]">{p.category.toUpperCase()}</span>
          </div>
          <h3 class="display mt-5 text-3xl leading-none transition-colors duration-300 group-hover:text-[var(--color-accent-ink)]">{p.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-3)]">{p.tagline}</p>
          <div class="mt-5 flex flex-wrap gap-1.5">
            {p.stack.slice(0, 4).map((t) => <span class="tag">{t}</span>)}
          </div>
          <div class="mt-auto flex items-center justify-between gap-4 pt-6">
            <span class="tag" style="border-color:rgb(74 222 128 / 0.35); color:var(--color-ok)">● LIVE DEMO</span>
            <span class="arrow-slide font-mono text-xs text-[var(--color-ink-3)] transition-colors duration-300 group-hover:text-[var(--color-accent-ink)]">OPEN <span data-arrow>→</span></span>
          </div>
        </a>
      ))}
    </div>
    <div class="reveal mt-3 flex items-center gap-3" style="--rd:160ms">
      <div class="rail-progress"><div class="rail-progress-bar" id="rail-bar"></div></div>
      <span class="font-mono text-[0.68rem] tracking-[0.14em] text-[var(--color-ink-3)]">DRAG / SCROLL</span>
    </div>
  </section>

  <!-- Featured project deep dive -->
  <section class="border-y border-[var(--color-line-strong)] bg-[var(--color-card)]">
    <div class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-28">
      <div class="grid gap-4 lg:grid-cols-[auto_1fr] lg:items-end">
        <p class="reveal meta-label">02 - Featured</p>
        <h2 class="reveal display mt-3 text-4xl md:text-6xl">Deep dive: PhantomSection.</h2>
      </div>
      <p class="reveal mt-4 max-w-2xl text-[var(--color-ink-3)]" style="--rd:80ms">
        A C++ shellcode loader that walks the PEB, parses export address tables, and patches ETW - without touching a single documented API.
      </p>
      <div class="reveal mt-10 grid gap-6 lg:grid-cols-2" style="--rd:160ms">
        <!-- Flow preview -->
        <div class="console">
          <div class="console-bar">
            <i style="background:#f87171"></i><i style="background:#fbbf24"></i><i style="background:#34d399"></i>
            <span class="ml-2">EXECUTION FLOW - 6 STEPS</span>
          </div>
          <div class="console-body space-y-2">
            {projects[0].flow.slice(0, 4).map((f) => (
              <div class="flex gap-3">
                <span class="c-info font-semibold">{f.step}</span>
                <span>{f.title} - <span class="c-dim">{f.detail.slice(0, 60)}…</span></span>
              </div>
            ))}
            <div class="c-dim mt-2">… 2 more steps → full case file</div>
          </div>
        </div>
        <!-- MITRE table -->
        <div class="overflow-hidden rounded-2xl border border-[var(--color-line-strong)] bg-[var(--color-card-2)] p-6">
          <p class="meta-label">MITRE ATT&CK</p>
          <table class="spec-table mt-4">
            <thead><tr><th>Technique</th><th>Description</th></tr></thead>
            <tbody>
              {projects[0].tables[0].table.rows.map((r) => (
                <tr><td>{r[0]}</td><td>{r[1]}</td></tr>
              ))}
            </tbody>
          </table>
          <a href="/work/phantomsection" class="go-ghost mt-5" data-magnetic>Open case file →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Disciplines - bento -->
  <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-28">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr]">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <p class="reveal meta-label">03 - Disciplines</p>
        <h2 class="reveal display mt-3 text-4xl md:text-5xl">Where I<br />operate.</h2>
        <p class="reveal mt-5 max-w-md text-[var(--color-ink-3)]" style="--rd:80ms">
          From packet-level analysis to full-stack builds - the toolkit covers security, networking, systems, and development.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {profile.coreSkills.map((s, i) => (
          <div class={`reveal dossier p-6 ${i === 0 ? "sm:col-span-2" : ""}`} style={`--rd:${i * 70}ms`}>
            <div class="flex items-center justify-between">
              <h3 class="display text-xl">{s.title}</h3>
              <span class="font-mono text-[0.66rem] text-[var(--color-ink-3)]">0{i + 1}</span>
            </div>
            <div class="mt-4 flex flex-wrap gap-2">{s.tools.map((t) => <span class="tag">{t}</span>)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Journey timeline -->
  <section class="border-y border-[var(--color-line-strong)] bg-[var(--color-card)]">
    <div class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-28">
      <p class="reveal meta-label">04 - Journey</p>
      <h2 class="reveal display mt-3 text-4xl md:text-6xl">Built by breaking things.</h2>
      <ol class="mt-12">
        {profile.journey.map((j, i) => (
          <li class={`reveal grid gap-2 py-7 md:grid-cols-[180px_240px_1fr] md:gap-8 ${i > 0 ? "border-t border-[var(--color-line)]" : "border-t border-[var(--color-line-strong)]"}`} style={`--rd:${i * 70}ms`}>
            <span class="font-mono text-xs text-[var(--color-ink-3)]">{j.period}</span>
            <div>
              <h3 class="display text-xl">{j.title}</h3>
              <p class="font-mono text-[0.7rem] text-[var(--color-accent-ink)]">{j.org}</p>
            </div>
            <p class="text-sm leading-relaxed text-[var(--color-ink-3)]">{j.desc}</p>
          </li>
        ))}
      </ol>
      <div class="reveal mt-10 flex flex-wrap gap-4">
        <a href="/overview" class="btn-line" data-magnetic>Full overview →</a>
        <a href="/contact" class="btn-ink" data-magnetic>Start a conversation →</a>
      </div>
    </div>
  </section>
</Doc>