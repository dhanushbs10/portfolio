---
import Doc from "../layouts/Doc.astro";
import { profile } from "../data/profile";
import { projects } from "../data/projects";
import PixelSnow from "../components/reactbits/PixelSnow.tsx";
import ProfileCard from "../components/reactbits/ProfileCard.tsx";
import { TECH_LOGOS } from "../data/tech-logos";
const featured = projects.find((project) => project.slug === "zerotrust-soc-lab")!;
---

<Doc>
  <!-- Hero — React Bits PixelSnow (falling pixel snow) -->
  <section class="relative overflow-hidden bg-[var(--color-paper)] pt-32 pb-16 md:pt-44 md:pb-24">
    <div class="absolute inset-0 hidden md:block">
      <PixelSnow client:visible color="#ffffff" density={0.06} speed={0.14} pixelResolution={240} />
    </div>

    <div class="relative mx-auto max-w-7xl px-5 md:px-8">
      <div class="grid items-center gap-16 lg:grid-cols-[1.5fr_0.8fr]">
        <div>
          <!-- Main heading - character assembly (Stefan Vitasović-style) -->
          <h1 id="hero-title" class="display mt-10 text-[clamp(3.5rem,11vw,8.5rem)] leading-[0.82]" style="line-height:0.82" aria-label="Dhanush B S.">
            <span class="char-row">
              {"Dhanush".split("").map((c, i) => <span class="char" style={`--i:${i}`}>{c}</span>)}
            </span>
            <span class="char-row">
              {"BS".split("").map((c, i) => <span class="char" style={`--i:${i + 7}`}>{c}</span>)}
              <span class="char text-[var(--color-accent)]" style="--i:9">.</span>
            </span>
          </h1>

          <div class="mt-10 max-w-2xl">
            <div class="reveal" style="--rd:160ms">
              <p class="font-serif text-xl italic leading-relaxed text-[var(--color-ink-2)] md:text-2xl">
                "{profile.intro}"
              </p>
              <p class="mt-5 max-w-xl text-[0.92rem] leading-[1.85] text-[var(--color-ink-3)]">
                {profile.bio[0]}
              </p>
              <div class="mt-8 flex flex-wrap gap-4">
                <a href="/work" class="btn-ink" data-magnetic>Open the work <span aria-hidden="true">→</span></a>
                <a href="/contact" class="btn-line" data-magnetic>Contact</a>
              </div>
            </div>
          </div>

          <!-- Scroll hint -->
          <div class="reveal mt-16 flex items-center gap-4 font-mono text-[0.66rem] tracking-[0.24em] text-[var(--color-ink-3)]" style="--rd:280ms">
            <span class="inline-block h-8 w-px bg-[var(--color-line-strong)]"></span>
            SCROLL TO EXPLORE
          </div>
        </div>

        <!-- Profile card -->
        <div class="reveal hidden justify-self-end lg:block" style="--rd:200ms">
          <ProfileCard client:load
            name="Dhanush B S"
            title="Cybersecurity & Networking Student"
            handle="dhanushbs10"
            status="Open to internships"
            contactText="Contact Me"
            avatarUrl="/assets/demo/avatar.png"
            showUserInfo={false}
            enableTilt={true}
            enableMobileTilt={false}
            onContactClick={() => console.log('Contact clicked')}
            iconUrl="/assets/demo/iconpattern.png"
            grainUrl="/assets/demo/grain.webp"
            behindGlowEnabled
            innerGradient="linear-gradient(145deg,#60496e8c 0%,#71C4FF44 100%)" />
        </div>
      </div>
    </div>
  </section>

  <!-- Selected work - horizontal rail -->
  <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-28">
    <div class="reveal flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="meta-label">Selected work</p>
        <h2 class="display mt-3 text-4xl md:text-6xl">{projects.length} builds,<br />each opened fully.</h2>
      </div>
      <a href="/work" class="btn-line !py-2.5" data-magnetic>All work →</a>
    </div>

    <div class="reveal rail mt-12" id="work-rail" style="--rd:120ms">
      {projects.map((p) => (
        <a href={`/work/${p.slug}`} class="dossier dossier-hover group flex min-h-[280px] flex-col p-6">
          <div class="flex items-center gap-4 font-mono text-[0.68rem] tracking-[0.18em]">
            <span class="text-[var(--color-ink-3)]">{p.category.toUpperCase()}</span>
          </div>
          <h3 class="display mt-5 text-[1.7rem] leading-tight break-words transition-colors duration-300 group-hover:text-[var(--color-ink)]">{p.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-3)]">{p.tagline}</p>
          <div class="mt-5 flex flex-wrap gap-1.5">
            {p.stack.slice(0, 4).map((t) => <span class="tag">{t}</span>)}
          </div>
          <div class="mt-auto flex flex-wrap items-center justify-between gap-2 pt-6">
            {p.slug === "zerotrust-soc-lab" ? <span class="tag shrink-0">LOCAL LAB</span> : !["shellplay", "pxe-network-boot-lab"].includes(p.slug) && <span class="tag shrink-0" style="border-color:rgb(74 222 128 / 0.35); color:var(--color-ok)">● LIVE DEMO</span>}
            <span class="arrow-slide shrink-0 font-mono text-xs whitespace-nowrap text-[var(--color-ink-3)] transition-colors duration-300 group-hover:text-[var(--color-ink)]">OPEN <span data-arrow>→</span></span>
          </div>
        </a>
      ))}
    </div>
    <div class="reveal mt-3 flex items-center gap-3" style="--rd:160ms">
      <div class="rail-progress"><div class="rail-progress-bar" id="rail-bar"></div></div>
      <span class="font-mono text-[0.68rem] tracking-[0.14em] text-[var(--color-ink-3)]">DRAG / SCROLL</span>
    </div>
  </section>

  <!-- Featured project deep dive -->
  <section class="border-y border-[var(--color-line-strong)] bg-[var(--color-card)]">
    <div class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-28">
      <div class="grid gap-4 lg:grid-cols-[auto_1fr] lg:items-end">
        <p class="reveal meta-label">Featured</p>
        <h2 class="reveal display mt-3 text-4xl md:text-6xl">Featured: {featured.title}.</h2>
      </div>
      <p class="reveal mt-4 max-w-2xl text-[var(--color-ink-3)]" style="--rd:80ms">
        {featured.description}
      </p>
      <div class="reveal mt-10 grid gap-6 lg:grid-cols-2" style="--rd:160ms">
        <!-- Flow preview -->
        <div class="console">
          <div class="console-bar">
            <i style="background:#f87171"></i><i style="background:#fbbf24"></i><i style="background:#34d399"></i>
            <span class="ml-2">ATTACK-TO-DETECTION FLOW</span>
          </div>
          <div class="console-body space-y-2">
            {featured.flow.slice(0, 4).map((f) => (
              <div class="flex gap-3">
                <span class="c-info font-semibold">{f.step}</span>
                <span>{f.title} - <span class="c-dim">{f.detail.slice(0, 60)}…</span></span>
              </div>
            ))}
            <div class="c-dim mt-2">Telemetry and detection coverage are documented in the case file.</div>
          </div>
        </div>
        <!-- Lab inventory -->
        <div class="overflow-hidden rounded-2xl border border-[var(--color-line-strong)] bg-[var(--color-card-2)] p-6">
          <p class="meta-label">{featured.tables[0].title}</p>
          <table class="spec-table mt-4">
            <thead><tr><th>{featured.tables[0].table.head[0]}</th><th>{featured.tables[0].table.head[1]}</th></tr></thead>
            <tbody>
              {featured.tables[0].table.rows.map((r) => (
                <tr><td>{r[0]}</td><td>{r[1]}</td></tr>
              ))}
            </tbody>
          </table>
          <a href={`/work/${featured.slug}`} class="go-ghost mt-5" data-magnetic>Open case file →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Disciplines - bento -->
  <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-28">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr]">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <p class="reveal meta-label">Disciplines</p>
        <h2 class="reveal display mt-3 text-4xl md:text-5xl">Where I<br />operate.</h2>
        <p class="reveal mt-5 max-w-md text-[var(--color-ink-3)]" style="--rd:80ms">
          From packet-level analysis to full-stack builds - the toolkit covers security, networking, systems, and development.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {profile.coreSkills.map((s, i) => (
          <div class={`reveal dossier p-6 ${i === 0 ? "sm:col-span-2" : ""}`} style={`--rd:${i * 70}ms`}>
            <h3 class="display text-xl">{s.title}</h3>
            <div class="mt-4 flex flex-wrap gap-2">{s.tools.map((t) => <span class="tag">{t}</span>)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Journey timeline -->
  <section class="border-y border-[var(--color-line-strong)] bg-[var(--color-card)]">
    <div class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-28">
      <p class="reveal meta-label">Journey</p>
      <h2 class="reveal display mt-3 text-4xl md:text-6xl">Built by breaking things.</h2>
      <ol class="mt-12">
        {profile.journey.map((j, i) => (
          <li class={`reveal grid gap-2 py-7 md:grid-cols-[180px_240px_1fr] md:gap-8 ${i > 0 ? "border-t border-[var(--color-line)]" : "border-t border-[var(--color-line-strong)]"}`} style={`--rd:${i * 70}ms`}>
            <span class="font-mono text-xs text-[var(--color-ink-3)]">{j.period}</span>
            <div>
              <h3 class="display text-xl">{j.title}</h3>
              <p class="font-mono text-[0.7rem] text-[var(--color-accent-ink)]">{j.org}</p>
            </div>
            <p class="text-sm leading-relaxed text-[var(--color-ink-3)]">{j.desc}</p>
          </li>
        ))}
      </ol>
      <div class="reveal mt-10 flex flex-wrap gap-4">
        <a href="/overview" class="btn-line" data-magnetic>Full overview →</a>
        <a href="/contact" class="btn-ink" data-magnetic>Start a conversation →</a>
      </div>
    </div>
  </section>
<!-- Tech logos ticker -->
  <div class="overflow-hidden border-y border-[var(--color-line-strong)] bg-[var(--color-night)] py-4"
       style="mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);">
    <div class="animate-ticker flex w-max items-center gap-12">
      {[...TECH_LOGOS, ...TECH_LOGOS].map((l) => (
        <span class="flex shrink-0 items-center gap-12 opacity-70 transition-opacity duration-300 hover:opacity-100"
              title={l.title} aria-label={l.title}>
          <svg viewBox="0 0 24 24" class="h-[22px] w-[22px] fill-current text-[var(--color-ink-2)]"><path d={l.path} /></svg>
          <span class="text-[0.7rem] text-[var(--color-accent)]">&#183;</span>
        </span>
      ))}
    </div>
  </div>

</Doc>
