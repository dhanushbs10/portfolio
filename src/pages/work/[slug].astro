---
import Doc from "../../layouts/Doc.astro";
import VynloreLab from "../../components/labs/VynloreLab.astro";
import DroplinkLab from "../../components/labs/DroplinkLab.astro";
import ShellLab from "../../components/labs/ShellLab.astro";
import PhantomLab from "../../components/labs/PhantomLab.astro";
import PxeLab from "../../components/labs/PxeLab.astro";
import EspLab from "../../components/labs/EspLab.astro";
import SmbLab from "../../components/labs/SmbLab.astro";
import { projects } from "../../data/projects";

export async function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = projects.find((p) => p.slug === slug);
if (!project) throw new Error(`Unknown project: ${slug}`);
const p = project;
const idx = projects.findIndex((x) => x.slug === slug);
const next = projects[(idx + 1) % projects.length];
const prev = projects[(idx - 1 + projects.length) % projects.length];
const chapters = [
  ["#overview", "01 · Overview"],
  ["#exhibit", "02 · Live exhibit"],
  ["#evidence", "03 · Evidence"],
  ["#build", "04 · Build log"],
];
---

<Doc title={p.title} active="work" description={p.description}>
  <article class="mx-auto max-w-6xl px-5 pt-32 pb-20 md:px-8 md:pt-40">
    <div class="reveal flex flex-wrap items-center gap-x-5 gap-y-2 border-y border-[var(--color-line-strong)] py-3 font-mono text-[0.68rem] tracking-[0.2em] text-[var(--color-ink-2)]">
      <a href="/work" class="hover:text-[var(--color-ink)]">← ARCHIVE</a>
      <span>CASE FILE {p.index} / 07</span>
      <span class="text-[var(--color-accent-ink)]">{p.category.toUpperCase()}</span>
      <a href={p.github} target="_blank" rel="noreferrer" class="ml-auto hover:text-[var(--color-ink)]">GITHUB ↗</a>
    </div>

    <h1 class="reveal display mt-8 text-[clamp(2.6rem,7vw,5.5rem)]" style="--rd:80ms">{p.title}</h1>
    <p class="reveal mt-4 max-w-2xl font-serif text-xl italic md:text-2xl" style="--rd:140ms">{p.tagline}</p>

    <div class="mt-12 grid gap-10 lg:grid-cols-[200px_1fr]">
      <aside class="hidden lg:block">
        <nav class="sticky top-28 space-y-1">
          {chapters.map(([href, label]) => (
            <a href={href} class="chapter-link block py-2 pl-4 font-mono text-[0.72rem] tracking-[0.1em] text-[var(--color-ink-3)] hover:text-[var(--color-ink)]">{label}</a>
          ))}
          <div class="pt-6">
            <a href={p.github} target="_blank" rel="noreferrer" class="btn-ink w-full justify-center !text-[0.8rem]">Repository ↗</a>
            {p.extraLink && <a href={p.extraLink.href} target="_blank" rel="noreferrer" class="btn-line mt-3 w-full justify-center !text-[0.8rem]">{p.extraLink.label} ↗</a>}
          </div>
        </nav>
      </aside>

      <div class="min-w-0">
        <section id="overview" class="scroll-mt-28">
          <p class="reveal meta-label">01 — Overview</p>
          <p class="reveal mt-4 max-w-3xl leading-[1.85] text-[var(--color-ink-2)]" style="--rd:80ms">{p.description}</p>
          <ul class="mt-7 grid gap-3 sm:grid-cols-2">
            {p.features.map((f, i) => (
              <li class="reveal dossier flex gap-3 p-4 text-sm leading-relaxed" style={`--rd:${i * 60}ms`}>
                <span class="font-mono text-[0.7rem] text-[var(--color-accent-ink)]">✓</span>{f}
              </li>
            ))}
          </ul>
          <div class="reveal mt-6 flex flex-wrap gap-1.5">{p.stack.map((t) => <span class="tag">{t}</span>)}</div>
          {p.disclaimer && (
            <div class="reveal mt-6 rounded-xl border border-amber-600/40 bg-amber-50 p-5 text-sm leading-relaxed" style="color:#7c4a12">
              <span class="font-mono text-[0.68rem] tracking-[0.18em]">DISCLAIMER — </span>{p.disclaimer}
            </div>
          )}
        </section>

        <section id="exhibit" class="mt-16 scroll-mt-28">
          <p class="reveal meta-label">02 — Live exhibit · try it here</p>
          <div class="reveal mt-4" style="--rd:80ms">
            {p.slug === "vynlore" && <VynloreLab />}
            {p.slug === "droplink" && <DroplinkLab />}
            {p.slug === "shellplay" && <ShellLab />}
            {p.slug === "phantomsection" && <PhantomLab />}
            {p.slug === "pxe-network-boot-lab" && <PxeLab />}
            {p.slug === "esp8266-wake-on-lan" && <EspLab />}
            {p.slug === "cross-subnet-smb-fix" && <SmbLab />}
          </div>
        </section>

        <section id="evidence" class="mt-16 scroll-mt-28">
          <p class="reveal meta-label">03 — Evidence · from the repo</p>
          <div class="reveal mt-4" style="--rd:60ms">
            <h3 class="display text-2xl md:text-3xl">How it works</h3>
            <ol class="mt-6 space-y-0 overflow-hidden rounded-2xl border border-[var(--color-line-strong)] bg-[var(--color-card)]">
              {p.flow.map((f, i) => (
                <li class={`grid gap-1 p-5 md:grid-cols-[60px_200px_1fr] md:gap-4 md:p-6 ${i > 0 ? "border-t border-[var(--color-line)]" : ""}`}>
                  <span class="font-mono text-sm text-[var(--color-accent-ink)]">{f.step}</span>
                  <span class="font-semibold">{f.title}</span>
                  <span class="text-sm leading-relaxed text-[var(--color-ink-2)]">{f.detail}</span>
                </li>
              ))}
            </ol>
          </div>
          {p.tables.map((t) => (
            <div class="reveal mt-8" style="--rd:60ms">
              <h4 class="font-mono text-[0.72rem] tracking-[0.18em] text-[var(--color-accent-ink)]">{t.title.toUpperCase()}</h4>
              {t.note && <p class="mt-1 font-mono text-[0.7rem] text-[var(--color-ink-3)]">{t.note}</p>}
              <div class="mt-3 overflow-x-auto rounded-2xl border border-[var(--color-line-strong)] bg-[var(--color-card)]">
                <table class="spec-table">
                  <thead><tr><th>{t.table.head[0]}</th><th>{t.table.head[1]}</th></tr></thead>
                  <tbody>{t.table.rows.map(([a, b]) => <tr><td>{a}</td><td>{b}</td></tr>)}</tbody>
                </table>
              </div>
            </div>
          ))}
          {p.code && p.code.map((c) => (
            <div class="reveal mt-8" style="--rd:60ms">
              <h4 class="font-mono text-[0.72rem] tracking-[0.18em] text-[var(--color-accent-ink)]">{c.title.toUpperCase()}</h4>
              <div class="console mt-3">
                <div class="console-bar"><i style="background:#f87171"></i><i style="background:#fbbf24"></i><i style="background:#34d399"></i><span class="ml-2">{c.lang}</span></div>
                <pre class="console-body overflow-x-auto whitespace-pre">{c.body}</pre>
              </div>
            </div>
          ))}
        </section>

        <section id="build" class="mt-16 scroll-mt-28">
          <p class="reveal meta-label">04 — Build log · reproduce it</p>
          <div class="reveal console mt-4" style="--rd:80ms">
            <div class="console-bar"><i style="background:#f87171"></i><i style="background:#fbbf24"></i><i style="background:#34d399"></i><span class="ml-2">REPRODUCE</span></div>
            <div class="console-body">
              {p.build.map((b) => <div><span class="c-dim">$ </span>{b}</div>)}
            </div>
          </div>
        </section>

        <nav class="mt-16 grid gap-4 border-t-2 border-[var(--color-ink)] pt-8 md:grid-cols-2">
          <a href={`/work/${prev.slug}`} class="dossier dossier-hover group p-6">
            <span class="meta-label">← Previous file</span>
            <span class="display mt-2 block text-2xl group-hover:text-[var(--color-accent-ink)]">{prev.title}</span>
          </a>
          <a href={`/work/${next.slug}`} class="dossier dossier-hover group p-6 text-right">
            <span class="meta-label">Next file →</span>
            <span class="display mt-2 block text-2xl group-hover:text-[var(--color-accent-ink)]">{next.title}</span>
          </a>
        </nav>
      </div>
    </div>
  </article>
</Doc>
