---
import Doc from "../../layouts/Doc.astro";
import VynloreLab from "../../components/labs/VynloreLab.astro";
import DroplinkLab from "../../components/labs/DroplinkLab.astro";
import ShellLab from "../../components/labs/ShellLab.astro";
import PhantomLab from "../../components/labs/PhantomLab.astro";
import PxeLab from "../../components/labs/PxeLab.astro";
import EspLab from "../../components/labs/EspLab.astro";
import SmbLab from "../../components/labs/SmbLab.astro";
import { projects } from "../../data/projects";

export async function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = projects.find((p) => p.slug === slug);
if (!project) throw new Error(`Unknown project: ${slug}`);
const p = project;
const idx = projects.findIndex((x) => x.slug === slug);
const next = projects[(idx + 1) % projects.length];
const prev = projects[(idx - 1 + projects.length) % projects.length];
const chapters = [
  ["#overview", "01 · Overview"],
  ["#exhibit", "02 · Live exhibit"],
  ["#evidence", "03 · Evidence"],
  ["#build", "04 · Build log"],
];

const accentGradients: Record<string, string> = {
  phantomsection: "project-accent-1",
  droplink: "project-accent-2",
  vynlore: "project-accent-3",
  shellplay: "project-accent-4",
  "pxe-network-boot-lab": "project-accent-5",
  "esp8266-wake-on-lan": "project-accent-6",
  "cross-subnet-smb-fix": "project-accent-7",
};
const accentClass = accentGradients[p.slug] ?? "project-accent-1";
---

<Doc title={p.title} active="work" description={p.description}>
  <article>
    <!-- Hero banner with accent gradient -->
    <div class={`${accentClass} relative overflow-hidden pt-32 pb-16 md:pt-44 md:pb-24`}>
      <div class="absolute inset-0 opacity-[0.06]" style="background-image: linear-gradient(to right, #fff 1px, transparent 1px), linear-gradient(to bottom, #fff 1px, transparent 1px); background-size: 48px 48px;"></div>
      <div class="relative mx-auto max-w-7xl px-5 md:px-8">
        <div class="reveal flex flex-wrap items-center gap-x-5 gap-y-2 border-b border-white/20 pb-3 font-mono text-[0.68rem] tracking-[0.2em] text-white/70">
          <a href="/work" class="hover:text-white transition-colors">← ARCHIVE</a>
          <span>CASE FILE {p.index} / 07</span>
          <span>{p.category.toUpperCase()}</span>
          <a href={p.github} target="_blank" rel="noreferrer" class="ml-auto hover:text-white transition-colors">GITHUB ↗</a>
        </div>
        <h1 class="reveal display mt-8 text-[clamp(2.8rem,7vw,6rem)] text-white" style="--rd:80ms">{p.title}</h1>
        <p class="reveal mt-4 max-w-2xl font-serif text-xl italic text-white/80 md:text-2xl" style="--rd:140ms">{p.tagline}</p>
        <div class="reveal mt-6 flex flex-wrap gap-2" style="--rd:200ms">
          {p.stack.slice(0, 5).map((t) => (
            <span class="rounded-full border border-white/25 px-3.5 py-1.5 font-mono text-[0.68rem] text-white/80">{t}</span>
          ))}
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-7xl px-5 pt-12 pb-20 md:px-8 md:pt-16">
      <div class="grid gap-10 lg:grid-cols-[220px_1fr]">
        <!-- Sticky chapter nav -->
        <aside class="hidden lg:block">
          <nav class="sticky top-28 space-y-1">
            {chapters.map(([href, label]) => (
              <a href={href} class="chapter-link block py-2 pl-4 font-mono text-[0.72rem] tracking-[0.1em] text-[var(--color-ink-3)] hover:text-[var(--color-ink)] transition-colors">{label}</a>
            ))}
            <div class="pt-6 space-y-3">
              <a href={p.github} target="_blank" rel="noreferrer" class="btn-ink w-full justify-center !text-[0.8rem]" data-magnetic>Repository ↗</a>
              {p.extraLink && <a href={p.extraLink.href} target="_blank" rel="noreferrer" class="btn-line w-full justify-center !text-[0.8rem]" data-magnetic>{p.extraLink.label} ↗</a>}
            </div>
          </nav>
        </aside>

        <div class="min-w-0">
          <!-- Section: Overview -->
          <section id="overview" class="scroll-mt-28">
            <p class="reveal meta-label">01 - Overview</p>
            <p class="reveal mt-4 max-w-3xl leading-[1.85] text-[var(--color-ink-2)]" style="--rd:80ms">{p.description}</p>
            <ul class="mt-7 grid gap-3 sm:grid-cols-2">
              {p.features.map((f, i) => (
                <li class="reveal dossier flex gap-3 p-4 text-sm leading-relaxed" style={`--rd:${i * 60}ms`}>
                  <span class="mt-0.5 font-mono text-[0.7rem] text-[var(--color-accent-ink)]">✓</span><span>{f}</span>
                </li>
              ))}
            </ul>
            <div class="reveal mt-6 flex flex-wrap gap-1.5">{p.stack.map((t) => <span class="tag">{t}</span>)}</div>
            {p.disclaimer && (
              <div class="reveal mt-6 rounded-xl border border-[#b45309]/40 bg-[#1a1208] p-5 text-sm leading-relaxed text-[#fbbf24]" style="--rd:80ms">
                <span class="font-mono text-[0.68rem] tracking-[0.18em] opacity-70">DISCLAIMER - </span>{p.disclaimer}
              </div>
            )}
          </section>

          <!-- Section: Live exhibit -->
          <section id="exhibit" class="mt-20 scroll-mt-28">
            <div class="reveal border-t border-[var(--color-line)] pt-10">
              <p class="meta-label">02 - Live exhibit · try it here</p>
              <p class="mt-2 text-sm text-[var(--color-ink-3)]">Interactive - runs entirely in your browser.</p>
            </div>
            <div class="reveal mt-6" style="--rd:80ms">
              {p.slug === "vynlore" && <VynloreLab />}
              {p.slug === "droplink" && <DroplinkLab />}
              {p.slug === "shellplay" && <ShellLab />}
              {p.slug === "phantomsection" && <PhantomLab />}
              {p.slug === "pxe-network-boot-lab" && <PxeLab />}
              {p.slug === "esp8266-wake-on-lan" && <EspLab />}
              {p.slug === "cross-subnet-smb-fix" && <SmbLab />}
            </div>
          </section>

          <!-- Section: Evidence -->
          <section id="evidence" class="mt-20 scroll-mt-28">
            <div class="reveal border-t border-[var(--color-line)] pt-10">
              <p class="meta-label">03 - Evidence · from the repo</p>
            </div>

            <!-- Flow -->
            <div class="reveal mt-8" style="--rd:60ms">
              <h3 class="display text-2xl md:text-3xl">How it works</h3>
              <ol class="mt-6 space-y-0 overflow-hidden rounded-2xl border border-[var(--color-line-strong)] bg-[var(--color-card)]">
                {p.flow.map((f, i) => (
                  <li class={`group grid gap-1 p-5 transition-colors hover:bg-[var(--color-paper)] md:grid-cols-[60px_200px_1fr] md:gap-4 md:p-6 ${i > 0 ? "border-t border-[var(--color-line)]" : ""}`}>
                    <span class="font-mono text-sm text-[var(--color-accent-ink)]">{f.step}</span>
                    <span class="font-semibold">{f.title}</span>
                    <span class="text-sm leading-relaxed text-[var(--color-ink-2)]">{f.detail}</span>
                  </li>
                ))}
              </ol>
            </div>

            <!-- Tables -->
            {p.tables.map((t, ti) => (
              <div class="reveal mt-8" style={`--rd:${ti * 60}ms`}>
                <h4 class="font-mono text-[0.72rem] tracking-[0.18em] text-[var(--color-accent-ink)]">{t.title.toUpperCase()}</h4>
                {t.note && <p class="mt-1 font-mono text-[0.7rem] text-[var(--color-ink-3)]">{t.note}</p>}
                <div class="mt-3 overflow-x-auto rounded-2xl border border-[var(--color-line-strong)] bg-[var(--color-card)]">
                  <table class="spec-table">
                    <thead><tr><th>{t.table.head[0]}</th><th>{t.table.head[1]}</th></tr></thead>
                    <tbody>{t.table.rows.map(([a, b]) => <tr><td>{a}</td><td>{b}</td></tr>)}</tbody>
                  </table>
                </div>
              </div>
            ))}

            <!-- Code blocks -->
            {p.code && p.code.map((c, ci) => (
              <div class="reveal mt-8" style={`--rd:${ci * 60}ms`}>
                <h4 class="font-mono text-[0.72rem] tracking-[0.18em] text-[var(--color-accent-ink)]">{c.title.toUpperCase()}</h4>
                <div class="code-block mt-3">
                  <div class="code-block-header">
                    <i style="background:#f87171; width:10px; height:10px; border-radius:50%; display:inline-block"></i>
                    <i style="background:#fbbf24; width:10px; height:10px; border-radius:50%; display:inline-block"></i>
                    <i style="background:#34d399; width:10px; height:10px; border-radius:50%; display:inline-block"></i>
                    <span class="ml-2">{c.lang}</span>
                  </div>
                  <pre class="code-block-body overflow-x-auto whitespace-pre">{c.body}</pre>
                </div>
              </div>
            ))}
          </section>

          <!-- Section: Build log -->
          <section id="build" class="mt-20 scroll-mt-28">
            <div class="reveal border-t border-[var(--color-line)] pt-10">
              <p class="meta-label">04 - Build log · reproduce it</p>
            </div>
            <div class="reveal console mt-6" style="--rd:80ms">
              <div class="console-bar">
                <i style="background:#f87171"></i><i style="background:#fbbf24"></i><i style="background:#34d399"></i>
                <span class="ml-2">REPRODUCE</span>
              </div>
              <div class="console-body">
                {p.build.map((b, i) => (
                  <div class="flex gap-3 py-1">
                    <span class="c-info shrink-0">{String(i + 1).padStart(2, "0")}</span>
                    <span>{b}</span>
                  </div>
                ))}
              </div>
            </div>
          </section>

          <!-- Prev / Next nav -->
          <nav class="reveal mt-16 grid gap-4 border-t-2 border-[var(--color-ink)] pt-8 md:grid-cols-2">
            <a href={`/work/${prev.slug}`} class="dossier dossier-hover group p-6">
              <span class="meta-label">← Previous file</span>
              <span class="display mt-2 block text-2xl group-hover:text-[var(--color-accent-ink)] transition-colors">{prev.title}</span>
            </a>
            <a href={`/work/${next.slug}`} class="dossier dossier-hover group p-6 text-right">
              <span class="meta-label">Next file →</span>
              <span class="display mt-2 block text-2xl group-hover:text-[var(--color-accent-ink)] transition-colors">{next.title}</span>
            </a>
          </nav>
        </div>
      </div>
    </div>
  </article>
</Doc>
