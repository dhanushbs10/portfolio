---
import Doc from "../../layouts/Doc.astro";
import { projects, categories } from "../../data/projects";

const gradients = ["project-accent-1","project-accent-2","project-accent-3","project-accent-4","project-accent-5","project-accent-6","project-accent-7"];
---

<Doc title="Work" active="work" description="Seven case files across security, networking, systems and web.">
  <section class="mx-auto max-w-7xl px-5 pt-32 pb-20 md:px-8 md:pt-40">
    <div class="relative">
      <div aria-hidden="true" class="ghost display pointer-events-none absolute right-0 top-0 hidden select-none whitespace-nowrap text-[12vw] leading-none xl:block" style="letter-spacing:-0.04em">ARCHIVE</div>
      <p class="reveal meta-label">Archive — 07 case files</p>
      <h1 class="reveal display mt-3 text-5xl md:text-7xl">Every project,<br />fully opened.</h1>
      <p class="reveal mt-5 max-w-2xl text-[var(--color-ink-3)]" style="--rd:80ms">
        Ordered by depth — security research first. Each file carries its live exhibit, source-faithful evidence and build log.
      </p>
    </div>

    <!-- Filter pills -->
    <div class="reveal mt-8 flex flex-wrap gap-2" id="filters" style="--rd:120ms">
      {categories.map((c, i) => (
        <button data-filter={c} class={`tag cursor-pointer !py-2 !px-4 transition-all duration-300 ${i === 0 ? "!border-[var(--color-accent)] !bg-[var(--color-accent)] !text-white" : "hover:!border-[var(--color-accent)] hover:!text-[var(--color-accent-ink)]"}`}>{c}</button>
      ))}
    </div>

    <!-- Project grid -->
    <div class="mt-10 grid gap-5 md:grid-cols-2" id="grid">
      {projects.map((p, i) => (
        <a data-category={p.category} href={`/work/${p.slug}`}
           class={`dossier dossier-hover group flex flex-col ${i === 0 ? "md:col-span-2" : ""}`}
           style={`--rd:${i * 60}ms`}
        >
          <div class={`h-1 rounded-t-[13px] ${gradients[i]} opacity-70 transition-all duration-500 group-hover:opacity-100`}></div>
          <div class="p-7">
            <div class="flex items-center justify-between font-mono text-[0.68rem] tracking-[0.18em]">
              <span class="text-[var(--color-accent-ink)]">{p.index} / {p.category.toUpperCase()}</span>
              <span class="tag" style="border-color:rgb(74 222 128 / 0.35); color:var(--color-ok)">● LIVE DEMO</span>
            </div>
            <h2 class="display mt-5 text-4xl leading-none transition-colors duration-300 group-hover:text-[var(--color-accent-ink)]">{p.title}</h2>
            <p class="mt-3 max-w-xl text-sm leading-relaxed text-[var(--color-ink-3)]">{p.description}</p>
            <div class="mt-5 flex flex-wrap gap-1.5">
              {p.stack.slice(0, 5).map((t) => <span class="tag">{t}</span>)}
            </div>
            <span class="arrow-slide mt-5 inline-block font-mono text-xs text-[var(--color-ink-3)] transition-colors duration-300 group-hover:text-[var(--color-accent-ink)]">READ CASE FILE <span data-arrow>→</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <script>
    try {
      const btns = document.querySelectorAll("#filters button");
      const cards = document.querySelectorAll("#grid > a");
      const on = ["!border-[var(--color-accent)]", "!bg-[var(--color-accent)]", "!text-white"];
      btns.forEach((b) => b.addEventListener("click", () => {
        btns.forEach((x) => x.classList.remove(...on));
        b.classList.add(...on);
        const f = b.getAttribute("data-filter");
        cards.forEach((c) => {
          const match = f === "All" || c.getAttribute("data-category") === f;
          (c as HTMLElement).style.display = match ? "" : "none";
          if (match) c.classList.add("is-visible");
        });
      }));
    } catch { /* ignore */ }
  </script>
</Doc>