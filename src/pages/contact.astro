---
import Doc from "../layouts/Doc.astro";
import { profile } from "../data/profile";
const c = profile.contact;
---

<Doc title="Contact" active="contact" description="Get in touch - internships, projects, collaboration.">
  <section class="mx-auto max-w-7xl px-5 pt-32 pb-24 md:px-8 md:pt-40">
    <p class="reveal meta-label">Channel - open to internships</p>
    <h1 class="reveal display mt-3 text-[clamp(3.4rem,8vw,7rem)]">Let's talk<span class="text-gradient">.</span></h1>
    <p class="reveal mt-6 max-w-xl leading-relaxed text-[var(--color-ink-3)]" style="--rd:80ms">
      Projects, internships, or technical questions - any channel works. I usually reply within a day.
    </p>

    <!-- Contact cards -->
    <div class="mt-12 grid gap-4 md:grid-cols-2">
      <a href={`mailto:${c.email}`} class="reveal dossier dossier-hover group p-8" data-magnetic>
        <p class="meta-label">Email</p>
        <p class="display mt-3 break-all text-2xl group-hover:text-[var(--color-accent-ink)] transition-colors md:text-[1.7rem]">{c.email}</p>
        <span class="arrow-slide mt-4 inline-block font-mono text-xs text-[var(--color-accent-ink)]">SEND AN EMAIL <span data-arrow>→</span></span>
      </a>
      <a href={`tel:${c.phone.replace(/\s/g, "")}`} class="reveal dossier dossier-hover group p-8" style="--rd:80ms" data-magnetic>
        <p class="meta-label">Phone</p>
        <p class="display mt-3 text-2xl group-hover:text-[var(--color-accent-ink)] transition-colors md:text-[1.7rem]">{c.phone}</p>
        <span class="arrow-slide mt-4 inline-block font-mono text-xs text-[var(--color-accent-ink)]">CALL <span data-arrow>→</span></span>
      </a>
      <a href={c.github} target="_blank" rel="noreferrer" class="reveal dossier dossier-hover group p-8" style="--rd:140ms" data-magnetic>
        <p class="meta-label">GitHub</p>
        <p class="display mt-3 text-2xl group-hover:text-[var(--color-accent-ink)] transition-colors">github.com/dhanushbs10</p>
        <span class="arrow-slide mt-4 inline-block font-mono text-xs text-[var(--color-accent-ink)]">VIEW CODE <span data-arrow>→</span></span>
      </a>
      <a href={c.linkedin} target="_blank" rel="noreferrer" class="reveal dossier dossier-hover group p-8" style="--rd:200ms" data-magnetic>
        <p class="meta-label">LinkedIn</p>
        <p class="display mt-3 text-2xl group-hover:text-[var(--color-accent-ink)] transition-colors">Connect professionally</p>
        <span class="arrow-slide mt-4 inline-block font-mono text-xs text-[var(--color-accent-ink)]">CONNECT <span data-arrow>→</span></span>
      </a>
    </div>

    <!-- Status bar -->
    <div class="reveal mt-4 flex flex-col items-start justify-between gap-6 rounded-2xl bg-[var(--color-night)] p-8 text-[var(--color-ink)] md:flex-row md:items-center" style="--rd:240ms">
      <div>
        <p class="meta-label text-[var(--color-ink-3)]">Currently</p>
        <p class="mt-2 text-lg font-semibold">{profile.status}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/work" class="btn-ink" data-magnetic>Browse the work →</a>
        <a href={`mailto:${c.email}`} class="btn-line" data-magnetic>Quick email</a>
      </div>
    </div>
  </section>
</Doc>