---
import Doc from "../layouts/Doc.astro";
import { projects } from "../data/projects";
---

<Doc title="404 - Not found" description="This page doesn't exist. Back to the work.">
  <section class="mx-auto flex min-h-[70vh] max-w-7xl flex-col justify-center px-5 pt-32 pb-20 md:px-8 md:pt-40">
    <div class="reveal flex flex-wrap items-center gap-x-5 gap-y-2 border-y border-[var(--color-line-strong)] py-3 font-mono text-[0.68rem] tracking-[0.2em] text-[var(--color-ink-2)]">
      <span>ERROR - 404</span><span>RESOURCE NOT FOUND</span>
    </div>
    <h1 class="reveal display mt-8 text-[clamp(3.5rem,11vw,8.5rem)]" style="--rd:80ms">
      404<span class="text-gradient">.</span>
    </h1>
    <p class="reveal mt-4 max-w-xl font-serif text-xl italic text-[var(--color-ink-2)] md:text-2xl" style="--rd:140ms">
      The page you opened doesn't exist - back to the files.
    </p>
    <div class="reveal mt-8 flex flex-wrap gap-4" style="--rd:200ms">
      <a href="/" class="btn-ink" data-magnetic>Back home →</a>
      <a href="/work" class="btn-line" data-magnetic>Browse the work</a>
    </div>
  </section>
</Doc>