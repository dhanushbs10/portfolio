---
import Doc from "../layouts/Doc.astro";
---

<Doc title="Chat" description="Chat with Ping, Dhanush B S's AI assistant." active="ping">
  <main class="chat-page"></main>
</Doc>

<style>
  .chat-page {
    min-height: 100dvh;
    padding-top: 4rem;
    background:
      radial-gradient(760px 480px at 18% 0%, color-mix(in srgb, #d6d9df 3.5%, transparent), transparent 55%),
      var(--color-paper);
  }
</style>
