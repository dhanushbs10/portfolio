---
import Doc from "../../layouts/Doc.astro";
---

<Doc
  title="Signal Room"
  description="An off-menu web reconnaissance challenge."
  noindex={true}
>
  <section class="mx-auto max-w-4xl px-5 pb-24 pt-32 md:px-8 md:pt-40">
    <p class="meta-label">Unlisted endpoint · challenge 01</p>
    <h1 class="display mt-4 text-5xl md:text-7xl">Signal room<span class="text-[var(--color-accent)]">.</span></h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-2)]">
      A hex packet was left in the robot log. The site's night color is the key. Recover the message, wrap it as a flag, and submit it here.
    </p>

    <div class="dossier mt-10 p-6 md:p-8">
      <p class="meta-label">Transmission</p>
      <p class="mt-3 font-mono text-sm leading-8 text-[var(--color-ink-2)] md:text-base">
        The packet is hex. The night token is a repeating XOR key. The message arrived backwards.
      </p>
    </div>

    <form id="ctf-form" class="mt-8 flex flex-col gap-3 sm:flex-row" autocomplete="off">
      <label class="sr-only" for="ctf-flag">CTF flag</label>
      <input
        id="ctf-flag"
        name="flag"
        maxlength="96"
        spellcheck="false"
        autocapitalize="off"
        class="flag-input min-w-0 flex-1 rounded-full border border-[var(--color-line-strong)] bg-[var(--color-card)] px-5 py-3 font-mono text-sm text-[var(--color-ink)] outline-none focus:border-[var(--color-accent)]"
        placeholder="flag{...}"
        required
      />
      <button class="btn-ink" type="submit">Submit flag →</button>
    </form>
    <p id="ctf-result" class="mt-4 min-h-6 font-mono text-sm text-[var(--color-ink-2)]" aria-live="polite" role="status"></p>
  </section>
  <div id="paper-blast" class="paper-blast" aria-hidden="true"></div>

  <script>
    const form = document.querySelector("#ctf-form");
    const input = document.querySelector("#ctf-flag");
    const result = document.querySelector("#ctf-result");
    const submit = form?.querySelector('button[type="submit"]');
    const burst = document.querySelector("#paper-blast");

    input?.addEventListener("input", () => input.classList.remove("is-rejected"));

    const shakeRejectedInput = () => {
      if (!input) return;
      input.classList.remove("is-rejected");
      void input.offsetWidth;
      input.classList.add("is-rejected");
    };

    const playSuccessSound = () => {
      try {
        const AudioContextClass = window.AudioContext || (window as Window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
        if (!AudioContextClass) return;
        const context = new AudioContextClass();
        const oscillator = context.createOscillator();
        const gain = context.createGain();
        const now = context.currentTime;
        oscillator.type = "sawtooth";
        oscillator.frequency.setValueAtTime(520, now);
        oscillator.frequency.exponentialRampToValueAtTime(95, now + 0.32);
        gain.gain.setValueAtTime(0.0001, now);
        gain.gain.exponentialRampToValueAtTime(0.12, now + 0.025);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.36);
        oscillator.connect(gain);
        gain.connect(context.destination);
        oscillator.start(now);
        oscillator.stop(now + 0.38);
        oscillator.addEventListener("ended", () => context.close(), { once: true });
      } catch { /* Audio is an optional enhancement. */ }
    };

    const launchPaperBlast = () => {
      if (!burst) return;
      burst.replaceChildren();
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const particles = reducedMotion ? 0 : 140;
      for (let i = 0; i < particles; i += 1) {
        const particle = document.createElement("span");
        const fromLeft = i % 2 === 0;
        const startX = fromLeft ? Math.random() * 16 : 84 + Math.random() * 16;
        const endX = Math.random() * 100;
        const endY = 25 + Math.random() * 100;
        const colors = ["#e76f51", "#e9a23b", "#f4d35e", "#3d8f88", "#e5e1d8", "#f7f3eb"];
        particle.className = `confetti-piece ${Math.random() > 0.72 ? "confetti-dot" : ""}`;
        particle.style.setProperty("--start-x", `${startX}vw`);
        particle.style.setProperty("--start-y", `${80 + Math.random() * 24}vh`);
        particle.style.setProperty("--end-x", `${endX}vw`);
        particle.style.setProperty("--end-y", `${endY}vh`);
        particle.style.setProperty("--spin", `${Math.random() * 1800 - 900}deg`);
        particle.style.setProperty("--delay", `${Math.random() * 260}ms`);
        particle.style.setProperty("--fall-time", `${2200 + Math.random() * 1700}ms`);
        particle.style.setProperty("--piece-color", colors[Math.floor(Math.random() * colors.length)]);
        particle.style.setProperty("--piece-width", `${5 + Math.random() * 8}px`);
        particle.style.setProperty("--piece-height", `${9 + Math.random() * 13}px`);
        burst.append(particle);
        particle.addEventListener("animationend", () => particle.remove(), { once: true });
      }
      if (!reducedMotion) {
        burst.classList.remove("is-blasting");
        void burst.offsetWidth;
        burst.classList.add("is-blasting");
      }
    };

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!input || !result || !submit) return;
      submit.disabled = true;
      result.dataset.state = "loading";
      result.textContent = "Checking flag…";
      try {
        const response = await fetch("/api/ctf/verify", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ flag: input.value.trim() }),
        });
        const data = await response.json();
        if (response.ok && data.ok) {
          result.dataset.state = "success";
          result.style.color = "var(--color-accent-ink)";
          result.textContent = data.message ?? "Correct flag. Signal recovered.";
          launchPaperBlast();
          playSuccessSound();
        } else {
          result.dataset.state = "error";
          result.style.color = "#fb7185";
          result.textContent = data.message ?? "Incorrect flag. Keep searching.";
          shakeRejectedInput();
        }
      } catch {
        result.dataset.state = "error";
        result.style.color = "#fb7185";
        result.textContent = "The verifier is unreachable. Try again later.";
      } finally {
        submit.disabled = false;
      }
    });
  </script>

  <style>
    .flag-input.is-rejected {
      border-color: #fb7185;
      animation: flag-rejected 430ms ease-in-out;
    }

    @keyframes flag-rejected {
      0%, 100% { transform: translateX(0); }
      18%, 54% { transform: translateX(-8px); }
      36%, 72% { transform: translateX(8px); }
    }

    @media (prefers-reduced-motion: reduce) {
      .flag-input.is-rejected { animation: none; }
    }

    .paper-blast {
      position: fixed;
      inset: 0;
      z-index: 120;
      overflow: hidden;
      pointer-events: none;
    }

    .paper-blast :global(.confetti-piece) {
      position: absolute;
      top: var(--start-y);
      left: var(--start-x);
      width: var(--piece-width);
      height: var(--piece-height);
      border-radius: 2px;
      background: var(--piece-color);
      opacity: 0;
      box-shadow: 0 2px 8px rgb(0 0 0 / 14%);
      will-change: transform, opacity;
    }

    .paper-blast :global(.confetti-dot) {
      width: 9px;
      height: 9px;
      border-radius: 50%;
    }

    .paper-blast.is-blasting :global(.confetti-piece) {
      animation: paper-blast var(--fall-time) cubic-bezier(.16,.72,.3,1) var(--delay) both;
    }

    @keyframes paper-blast {
      0% { opacity: 0; transform: translate3d(0, 0, 0) rotate(0deg) scale(.5); }
      8% { opacity: 1; }
      45% { opacity: 1; transform: translate3d(calc(var(--end-x) - var(--start-x)), calc(var(--end-y) - var(--start-y) - 14vh), 0) rotate(calc(var(--spin) * .55)); }
      100% { opacity: 0; transform: translate3d(calc(var(--end-x) - var(--start-x)), calc(var(--end-y) - var(--start-y) + 20vh), 0) rotate(var(--spin)); }
    }

    @media (prefers-reduced-motion: reduce) {
      .paper-blast :global(.confetti-piece) { display: none; }
    }
  </style>
</Doc>
