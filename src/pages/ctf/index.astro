import Doc from "../../layouts/Doc.astro";
---

<Doc
  title="Signal Room"
  description="An off-menu web reconnaissance challenge."
  noindex={true}
>
  <section class="mx-auto max-w-4xl px-5 pb-24 pt-32 md:px-8 md:pt-40">
    <p class="meta-label">Unlisted endpoint · challenge 01</p>
    <h1 class="display mt-4 text-5xl md:text-7xl">Signal room<span class="text-[var(--color-accent)]">.</span></h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-2)]">
      Two witnesses left a proof token in different dialects. Reconstruct the payload and submit the transformed result. The flag stays server-side until the proof checks out.
    </p>

    <div class="dossier mt-10 space-y-5 p-6 md:p-8">
      <p class="meta-label">Intercepted message</p>
      <p class="font-mono text-sm leading-8 text-[var(--color-ink-2)] md:text-base">
        “The index names the featured SOC case. The theme names the dark. Put the darker witness first. Join them with a colon, use web-safe armor, then move the first six symbols to the tail.”
      </p>
      <details class="border-t border-[var(--color-line)] pt-4 text-sm text-[var(--color-ink-3)]">
        <summary class="cursor-pointer font-mono text-xs tracking-widest">OPEN FIELD NOTES</summary>
        <ol class="mt-3 list-inside list-decimal space-y-2 leading-relaxed">
          <li>The public sitemap is the index; use the featured SOC project’s slug.</li>
          <li>The stylesheet’s <code class="font-mono text-[var(--color-accent-ink)]">--color-night</code> value is the dark witness. Remove its hash.</li>
          <li>Join as <code class="font-mono">color:slug</code>, UTF-8 Base64URL encode without padding, then rotate left by six characters.</li>
        </ol>
      </details>
    </div>

    <form id="ctf-form" class="mt-8 flex flex-col gap-3 sm:flex-row" autocomplete="off">
      <label class="sr-only" for="ctf-proof">Proof token</label>
      <input
        id="ctf-proof"
        name="proof"
        maxlength="128"
        spellcheck="false"
        autocapitalize="off"
        class="min-w-0 flex-1 rounded-full border border-[var(--color-line-strong)] bg-[var(--color-card)] px-5 py-3 font-mono text-sm text-[var(--color-ink)] outline-none focus:border-[var(--color-accent)]"
        placeholder="Paste proof token"
        required
      />
      <button class="btn-ink" type="submit">Verify proof →</button>
    </form>
    <p id="ctf-result" class="mt-4 min-h-6 font-mono text-sm text-[var(--color-ink-3)]" aria-live="polite"></p>
  </section>

  <script lang="ts">
    const form = document.querySelector<HTMLFormElement>("#ctf-form");
    const input = document.querySelector<HTMLInputElement>("#ctf-proof");
    const result = document.querySelector<HTMLParagraphElement>("#ctf-result");
    const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!input || !result || !submit) return;
      submit.disabled = true;
      result.textContent = "Checking proof…";
      try {
        const response = await fetch("/api/ctf/verify", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ proof: input.value.trim() }),
        });
        const data = await response.json();
        if (response.ok && data.ok && typeof data.flag === "string") {
          result.textContent = `Accepted: ${data.flag}`;
          result.classList.remove("text-[var(--color-ink-3)]");
          result.classList.add("text-[var(--color-accent-ink)]");
        } else {
          result.textContent = data.message ?? "No match. Recheck the evidence and transform.";
        }
      } catch {
        result.textContent = "The verifier is unreachable. Try again later.";
      } finally {
        submit.disabled = false;
      }
    });
  </script>
</Doc>
