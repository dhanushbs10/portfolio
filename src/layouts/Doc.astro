---
import "../styles/paper.css";
import { profile } from "../data/profile";
import { projects } from "../data/projects";

interface Props {
  title?: string;
  description?: string;
  active?: string;
}

const { title, description, active } = Astro.props;
const pageTitle = title ? `${title} — ${profile.name}` : `${profile.name} — ${profile.role}`;
const pageDesc = description ?? profile.intro;

const stats = [
  { label: "Projects shipped", value: 7 },
  { label: "Open-source repos", value: 7 },
  { label: "Networking labs", value: 3 },
  { label: "Languages used", value: 5 },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDesc} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0b0d12" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen">

    <!-- Preloader -->
    <div class="preloader" id="preloader">
      <div class="preloader-text">
        {"dhanush.".split("").map((ch, i) => <span style={`--i:${i}`}>{ch}</span>)}
      </div>
    </div>

    <!-- Grain overlay -->
    <div class="grain" aria-hidden="true"></div>

    <!-- Page transition overlay -->
    <div class="page-transition" id="page-transition" aria-hidden="true"></div>

    <div id="progressbar" aria-hidden="true"></div>

    <!-- Header -->
    <header class="fixed inset-x-0 top-0 z-50 border-b border-[var(--color-line)] bg-[color-mix(in_srgb,var(--color-paper)_88%,transparent)] backdrop-blur-xl">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 md:px-8">
        <a href="/" class="flex items-center gap-3" data-magnetic>
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-[var(--color-accent)] font-mono text-sm font-bold text-[#0b0d12] transition-transform duration-300 hover:scale-110">d.</span>
          <span class="font-mono text-sm font-semibold tracking-tight">dhanush<span class="text-[var(--color-accent)]">.</span>folio</span>
        </a>
        <nav class="hidden items-center gap-8 font-mono text-[0.72rem] tracking-[0.16em] text-[var(--color-ink-2)] md:flex">
          <a class="sweep hover:text-[var(--color-ink)]" data-active={active === "work" ? "true" : undefined} href="/work">WORK</a>
          <a class="sweep hover:text-[var(--color-ink)]" data-active={active === "overview" ? "true" : undefined} href="/overview">OVERVIEW</a>
          <a class="sweep hover:text-[var(--color-ink)]" data-active={active === "contact" ? "true" : undefined} href="/contact">CONTACT</a>
        </nav>
        <div class="flex items-center gap-3">
          <button id="cmdk-btn" class="hidden rounded-lg border border-[var(--color-line-strong)] bg-[var(--color-card)] px-3 py-1.5 font-mono text-[0.7rem] text-[var(--color-ink-2)] hover:border-[var(--color-accent)] hover:text-[var(--color-ink)] sm:inline-flex" aria-label="Search" data-magnetic>⌘K</button>
          <a href="/contact" class="btn-ink !px-4 !py-2 !text-[0.8rem]" data-magnetic>Hire me</a>
        </div>
      </div>
      <div class="border-t border-[var(--color-line)] md:hidden">
        <nav class="mx-auto flex max-w-7xl items-center gap-6 overflow-x-auto px-5 py-2.5 font-mono text-[0.7rem] tracking-[0.16em] text-[var(--color-ink-2)]">
          <a href="/work">WORK</a><a href="/overview">OVERVIEW</a><a href="/contact">CONTACT</a>
        </nav>
      </div>
    </header>

    <main class="relative"><slot /></main>

    <!-- Footer -->
    <footer class="relative overflow-hidden border-t-2 border-[var(--color-line-strong)] bg-[var(--color-night)] text-[var(--color-ink)]">
      <!-- Decorative grid -->
      <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(to right, #fff 1px, transparent 1px), linear-gradient(to bottom, #fff 1px, transparent 1px); background-size: 60px 60px;"></div>

      <div class="relative mx-auto max-w-7xl px-5 py-20 md:px-8">
        <!-- Stats row -->
        <div class="reveal grid grid-cols-2 gap-6 border-b border-white/10 pb-10 md:grid-cols-4">
          {stats.map((s, i) => (
            <div style={`--rd:${i * 80}ms`}>
              <p class="stat-num text-4xl text-[var(--color-ink)] md:text-5xl" data-count-to={s.value}>0</p>
              <p class="mt-2 font-mono text-[0.68rem] tracking-[0.14em] text-white/50">{s.label.toUpperCase()}</p>
            </div>
          ))}
        </div>

        <!-- CTA row -->
        <div class="mt-14 flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="font-mono text-[0.7rem] tracking-[0.22em] text-white/40">NEXT STEP</p>
            <a href="/contact" class="display mt-4 inline-block text-5xl hover:text-white md:text-7xl">
              Let's build<span class="text-[var(--color-accent-ink)]">.</span>
            </a>
            <p class="mt-5 max-w-md text-sm leading-relaxed text-white/60">{profile.status} · {profile.location} · <span id="clock" class="font-mono">--:--</span> IST</p>
          </div>
          <div class="flex flex-col items-start gap-3 md:items-end">
            <div class="flex flex-wrap gap-3 font-mono text-xs">
              <a class="rounded-full border border-white/20 px-5 py-2.5 transition-all duration-300 hover:border-white hover:bg-white hover:text-[var(--color-ink)]" href={profile.contact.github} target="_blank" rel="noreferrer">GitHub ↗</a>
              <a class="rounded-full border border-white/20 px-5 py-2.5 transition-all duration-300 hover:border-white hover:bg-white hover:text-[var(--color-ink)]" href={profile.contact.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
              <a class="rounded-full border border-white/20 px-5 py-2.5 transition-all duration-300 hover:border-white hover:bg-white hover:text-[var(--color-ink)]" href={`mailto:${profile.contact.email}`}>Email ↗</a>
            </div>
          </div>
        </div>

        <!-- Bottom row -->
        <div class="mt-14 flex flex-col justify-between gap-3 border-t border-white/10 pt-6 font-mono text-[0.7rem] text-white/40 md:flex-row">
          <span>© 2026 {profile.name} · {profile.location}</span>
          <span>Built from scratch · Astro + Tailwind</span>
        </div>
      </div>
    </footer>

    <!-- CmdK palette -->
    <div id="cmdk" hidden class="fixed inset-0 z-[100] flex items-start justify-center bg-black/40 p-4 pt-[14vh] backdrop-blur-sm">
      <div class="w-full max-w-lg overflow-hidden rounded-2xl border border-[var(--color-line-strong)] bg-[var(--color-card)] shadow-2xl">
        <input id="cmdk-input" placeholder="Jump to a page or project…" class="w-full border-b border-[var(--color-line)] bg-transparent px-5 py-4 font-mono text-sm outline-none placeholder:text-[var(--color-ink-3)]" />
        <div id="cmdk-list" class="max-h-80 overflow-y-auto p-2"></div>
      </div>
    </div>

    <script define:vars={{ projectLinks: projects.map((p) => ({ label: `${p.index} — ${p.title}`, href: `/work/${p.slug}` })) }}>
      /* ── Preloader ── */
      try {
        const pre = document.getElementById("preloader");
        if (pre) {
          setTimeout(() => pre.classList.add("is-hidden"), 1400);
          setTimeout(() => pre.remove(), 2000);
        }
      } catch { /* ignore */ }

      /* ── Reveal observer ── */
      try {
        const els = () => document.querySelectorAll(".reveal:not(.is-visible), .reveal-left:not(.is-visible), .reveal-right:not(.is-visible), .reveal-scale:not(.is-visible)");
        if ("IntersectionObserver" in window) {
          const io = new IntersectionObserver(
            (es) => es.forEach((e) => { if (e.isIntersecting) e.target.classList.add("is-visible"); }),
            { threshold: 0.08, rootMargin: "0px 0px -4% 0px" }
          );
          els().forEach((el) => io.observe(el));
        }
        setTimeout(() => els().forEach((el) => el.classList.add("is-visible")), 3000);
      } catch { document.querySelectorAll(".reveal, .reveal-left, .reveal-right, .reveal-scale").forEach((el) => el.classList.add("is-visible")); }

      /* ── Progress bar ── */
      try {
        const bar = document.getElementById("progressbar");
        if (bar) addEventListener("scroll", () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
        }, { passive: true });
      } catch { /* ignore */ }

      /* ── Drag-to-scroll rails ── */
      try {
        document.querySelectorAll(".rail").forEach((rail) => {
          let down = false, sx = 0, sl = 0;
          rail.addEventListener("pointerdown", (e) => { down = true; sx = e.clientX; sl = rail.scrollLeft; rail.classList.add("dragging"); });
          addEventListener("pointermove", (e) => { if (down) rail.scrollLeft = sl - (e.clientX - sx); });
          addEventListener("pointerup", () => { down = false; rail.classList.remove("dragging"); });
        });
      } catch { /* ignore */ }

      /* ── Chapter scroll-spy ── */
      try {
        const links = [...document.querySelectorAll(".chapter-link")];
        if (links.length && "IntersectionObserver" in window) {
          const secs = links.map((l) => document.querySelector(l.getAttribute("href"))).filter(Boolean);
          const spy = new IntersectionObserver((es) => {
            es.forEach((e) => {
              if (e.isIntersecting) {
                links.forEach((l) => l.setAttribute("data-active", l.getAttribute("href") === "#" + e.target.id ? "true" : "false"));
              }
            });
          }, { rootMargin: "-30% 0px -60% 0px" });
          secs.forEach((s) => spy.observe(s));
        }
      } catch { /* ignore */ }

      /* ── Live clock ── */
      try {
        const clock = document.getElementById("clock");
        if (clock) {
          const t = () => { try { clock.textContent = new Date().toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit", timeZone: "Asia/Kolkata" }); } catch { /* ignore */ } };
          t(); setInterval(t, 30000);
        }
      } catch { /* ignore */ }

      /* ── Animated counters ── */
      try {
        const counters = document.querySelectorAll("[data-count-to]");
        if (counters.length && "IntersectionObserver" in window) {
          const cio = new IntersectionObserver((es) => {
            es.forEach((e) => {
              if (!e.isIntersecting) return;
              const el = e.target;
              const target = parseInt(el.dataset.countTo, 10);
              if (isNaN(target)) return;
              let current = 0;
              const step = Math.max(1, Math.floor(target / 30));
              const iv = setInterval(() => {
                current = Math.min(current + step, target);
                el.textContent = current;
                if (current >= target) clearInterval(iv);
              }, 40);
              cio.unobserve(el);
            });
          }, { threshold: 0.5 });
          counters.forEach((c) => cio.observe(c));
        }
      } catch { /* ignore */ }

      /* ── Magnetic button effect ── */
      try {
        document.querySelectorAll("[data-magnetic]").forEach((el) => {
          el.addEventListener("mousemove", (e) => {
            const rect = el.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            el.style.transform = `translate(${x * 0.2}px, ${y * 0.2}px)`;
          });
          el.addEventListener("mouseleave", () => { el.style.transform = ""; });
        });
      } catch { /* ignore */ }

      /* ── Page transition on nav links ── */
      try {
        const overlay = document.getElementById("page-transition");
        if (overlay) {
          document.querySelectorAll('a[href^="/"]').forEach((link) => {
            link.addEventListener("click", (e) => {
              if (e.metaKey || e.ctrlKey) return;
              e.preventDefault();
              overlay.classList.add("is-active");
              setTimeout(() => { window.location.href = link.href; }, 450);
            });
          });
        }
      } catch { /* ignore */ }

      /* ── CmdK palette ── */
      try {
        const pages = [
          { label: "Home", href: "/" },
          { label: "All work", href: "/work" },
          { label: "Overview", href: "/overview" },
          { label: "Contact", href: "/contact" },
          ...projectLinks,
        ];
        const pal = document.getElementById("cmdk");
        const input = document.getElementById("cmdk-input");
        const list = document.getElementById("cmdk-list");
        if (pal && input && list) {
          const render = (q = "") => {
            const items = pages.filter((p) => p.label.toLowerCase().includes(q.toLowerCase()));
            list.innerHTML = items.length
              ? items.map((p) => `<a href="${p.href}" class="flex items-center justify-between rounded-xl px-4 py-3 font-mono text-sm hover:bg-white/5"><span>${p.label}</span><span>→</span></a>`).join("")
              : `<p class="px-4 py-6 font-mono text-sm text-[var(--color-ink-3)]">No match.</p>`;
          };
          const open = () => { pal.hidden = false; render(); input.value = ""; setTimeout(() => input.focus(), 30); };
          const close = () => { pal.hidden = true; };
          document.getElementById("cmdk-btn")?.addEventListener("click", open);
          document.addEventListener("keydown", (e) => {
            if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") { e.preventDefault(); pal.hidden ? open() : close(); }
            if (e.key === "Escape") close();
          });
          pal.addEventListener("click", (e) => { if (e.target === pal) close(); });
          input.addEventListener("input", (e) => render(e.target.value));
        }
      } catch { /* ignore */ }
    </script>
  </body>
</html>
