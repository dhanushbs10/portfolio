---
// ESP lab - LCD simulator replaying the README's exact display flow,
// plus the real wiring map and a MAC → Config.h formatter.
---

<div class="grid gap-5 lg:grid-cols-[300px_1fr]" id="esp-lab">
  <div class="overflow-hidden rounded-2xl border border-[var(--color-line-strong)] bg-[var(--color-card)] p-6">
    <p class="meta-label">Device LCD - 16×2 I2C · 0x27</p>
    <div class="lcd mt-3">
      <p id="esp-l1">WiFi Connected   </p>
      <p id="esp-l2">Ready to Touch   </p>
    </div>
    <button id="esp-touch" class="go mt-4 w-full justify-center">👆 Touch sensor (D6)</button>
    <p class="mt-3 font-mono text-[0.66rem] leading-relaxed text-[var(--color-ink-3)]">Replays the firmware flow: Ready to Touch → WAKING PC... → Packet Sent!</p>
    <div class="mt-5 border-t border-[var(--color-line)] pt-4 font-mono text-[0.7rem] leading-loose text-[var(--color-ink-2)]">
      <p><span class="text-[var(--color-ink-3)]">LCD</span> D1/D2 · 5V VIN</p>
      <p><span class="text-[var(--color-ink-3)]">TOUCH</span> D6/GPIO12 · 3V3</p>
      <p><span class="text-[var(--color-ink-3)]">BOM</span> ~$8–12 · NodeMCU + LCD + TTP223</p>
    </div>
  </div>
  <div class="overflow-hidden rounded-2xl border border-[var(--color-line-strong)] bg-[var(--color-card)] p-6">
    <p class="meta-label">Target MAC → Config.h bytes</p>
    <input id="esp-mac" value="94:DE:80:7B:2F:99" class="field mt-3 font-mono uppercase" autocomplete="off" spellcheck="false" />
    <p id="esp-err" class="mt-2 hidden font-mono text-[0.72rem] text-red-400">Enter 6 hex pairs, e.g. 94:DE:80:7B:2F:99</p>
    <pre id="esp-out" class="mt-3 overflow-x-auto whitespace-pre-wrap break-all rounded-xl bg-[var(--color-card-2)] p-4 font-mono text-[0.74rem] leading-relaxed"> -  type a MAC  - </pre>
    <div id="esp-log" class="mt-3 min-h-[24px] font-mono text-[0.74rem]"></div>
  </div>
</div>

<script>
  (() => {
    const root = document.getElementById("esp-lab");
    if (!root || root.dataset.init) return;
    root.dataset.init = "1";

    // LCD replay - exact strings from the README's expected flow.
    const l1 = root.querySelector("#esp-l1");
    const l2 = root.querySelector("#esp-l2");
    const pad = (s) => (s + "                ").slice(0, 16);
    root.querySelector("#esp-touch").addEventListener("click", async (e) => {
      const btn = e.currentTarget;
      btn.disabled = true;
      l2.textContent = pad("WAKING PC...");
      await new Promise((r) => setTimeout(r, 1100));
      l2.textContent = pad("Packet Sent!");
      await new Promise((r) => setTimeout(r, 1300));
      l2.textContent = pad("Ready to Touch");
      btn.disabled = false;
    });

    // MAC → Config.h formatter (README format: {0x94, 0xDE, ...}).
    const macEl = root.querySelector("#esp-mac");
    const outEl = root.querySelector("#esp-out");
    const errEl = root.querySelector("#esp-err");
    const logEl = root.querySelector("#esp-log");
    const render = () => {
      const parts = macEl.value.trim().split(/[:\-]/);
      if (parts.length !== 6 || parts.some((p) => !/^[0-9a-fA-F]{2}$/.test(p))) {
        errEl.classList.remove("hidden");
        outEl.textContent = " -  type a MAC  - ";
        logEl.innerHTML = "";
        return;
      }
      errEl.classList.add("hidden");
      const bytes = parts.map((p) => "0x" + p.toUpperCase());
      outEl.textContent = `const byte TARGET_MAC[6] = {${bytes.join(", ")}};\n// 102-byte magic packet: 6 × FF + 16 × MAC → UDP :9 broadcast`;
      logEl.innerHTML = `<span class="text-[var(--color-ok)]">✓ valid - paste into Config.h, upload to NodeMCU 1.0</span>`;
    };
    macEl.addEventListener("input", render);
    render();
  })();
</script>
