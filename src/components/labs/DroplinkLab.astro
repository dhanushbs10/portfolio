---
// DropLink lab — real AES-256-GCM via WebCrypto, key derived with HKDF-SHA256
// exactly as the README documents (share token → HKDF → AES-GCM).
---

<div class="overflow-hidden rounded-2xl border border-[var(--color-line-strong)] bg-[var(--color-card)]" id="dl-lab">
  <div class="grid gap-0 md:grid-cols-2">
    <div class="p-6">
      <label class="meta-label">Share token</label>
      <input id="dl-pass" type="text" value="monsoon-lab-042" class="field mt-2" autocomplete="off" spellcheck="false" />
      <label class="meta-label mt-5 block">Secret message</label>
      <textarea id="dl-plain" rows="3" class="field mt-2">Meet at the lab. Bring the SSD.</textarea>
      <div class="mt-4 flex flex-wrap gap-3">
        <button id="dl-enc" class="go">🔒 Encrypt</button>
        <button id="dl-dec" class="go-ghost">🔓 Decrypt as receiver</button>
      </div>
    </div>
    <div class="border-t border-[var(--color-line)] bg-[#faf9f5] p-6 md:border-l md:border-t-0">
      <label class="meta-label">Wire output — ciphertext</label>
      <pre id="dl-cipher" class="mt-2 min-h-[86px] overflow-x-auto whitespace-pre-wrap break-all rounded-xl border border-[var(--color-line-strong)] bg-white p-4 font-mono text-[0.73rem] leading-relaxed text-[var(--color-accent-ink)]">— press Encrypt —</pre>
      <label class="meta-label mt-4 block">Receiver output</label>
      <pre id="dl-result" class="mt-2 min-h-[50px] whitespace-pre-wrap rounded-xl border border-[var(--color-line-strong)] bg-white p-4 font-mono text-[0.73rem]">—</pre>
      <p class="mt-4 font-mono text-[0.66rem] leading-relaxed text-[var(--color-ink-3)]">
        Mirrors the app: HKDF-SHA256 key from the token. A signaling server relaying this learns nothing. Change one letter of the token and decryption fails.
      </p>
    </div>
  </div>
</div>

<script>
  (() => {
    const root = document.getElementById("dl-lab");
    if (!root || root.dataset.init) return;
    root.dataset.init = "1";
    const enc = new TextEncoder(), dec = new TextDecoder();
    const passEl = root.querySelector("#dl-pass");
    const plainEl = root.querySelector("#dl-plain");
    const cipherEl = root.querySelector("#dl-cipher");
    const resultEl = root.querySelector("#dl-result");
    let last = null;

    const b64 = (buf) => btoa(String.fromCharCode(...new Uint8Array(buf)));
    const unb64 = (s) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));

    async function deriveKey(pass, salt) {
      const base = await crypto.subtle.importKey("raw", enc.encode(pass), "HKDF", false, ["deriveKey"]);
      return crypto.subtle.deriveKey(
        { name: "HKDF", hash: "SHA-256", salt, info: enc.encode("droplink-share") },
        base, { name: "AES-GCM", length: 256 }, false, ["encrypt", "decrypt"]
      );
    }

    root.querySelector("#dl-enc").addEventListener("click", async () => {
      try {
        const salt = crypto.getRandomValues(new Uint8Array(16));
        const iv = crypto.getRandomValues(new Uint8Array(12));
        const k = await deriveKey(passEl.value, salt);
        const ct = await crypto.subtle.encrypt({ name: "AES-GCM", iv }, k, enc.encode(plainEl.value));
        last = `${b64(salt)}.${b64(iv)}.${b64(ct)}`;
        cipherEl.textContent = last;
        cipherEl.style.color = "";
        resultEl.textContent = "— now press Decrypt as receiver —";
      } catch { cipherEl.textContent = "Encryption failed in this browser."; }
    });

    root.querySelector("#dl-dec").addEventListener("click", async () => {
      if (!last) { resultEl.textContent = "Nothing to decrypt yet — encrypt first."; return; }
      try {
        const [s, iv, ct] = last.split(".").map(unb64);
        const k = await deriveKey(passEl.value, s);
        resultEl.textContent = dec.decode(await crypto.subtle.decrypt({ name: "AES-GCM", iv }, k, ct));
      } catch {
        resultEl.textContent = "✗ Decryption failed — token mismatch (restore the original token).";
      }
    });
  })();
</script>
