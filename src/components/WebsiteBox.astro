---
interface Props {
  src: string;
  title?: string;
  aspect?: string;
  size?: "sm" | "md" | "lg";
}
const { src, title = "Preview", aspect = "video", size = "md" } = Astro.props;
const aspectClass = aspect === "square" ? "aspect-square" : "aspect-video";
const sizeClass = size === "lg" ? "max-w-[900px]" : size === "sm" ? "max-w-[420px]" : "max-w-[680px]";
---
<div class={`group relative mx-auto w-full ${sizeClass} overflow-hidden rounded-xl border border-[var(--color-line-strong)] bg-[var(--color-card)] ${aspectClass}`}>
  <iframe
    src={src}
    title={title}
    class="h-full w-full"
    loading="lazy"
    sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-downloads"
    referrerpolicy="no-referrer"
    allow="clipboard-read; clipboard-write"
    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
  ></iframe>
  <div id="fallback-{title}" class="absolute inset-0 hidden flex-col items-center justify-center bg-[var(--color-card)] p-6 text-center">
    <p class="font-mono text-xs text-[var(--color-ink-3)]">Preview blocked by site headers</p>
    <a href={src} target="_blank" class="go mt-3">Open in new tab ↗</a>
  </div>
  <div class="pointer-events-none absolute inset-0 border border-white/0 transition-colors group-hover:border-white/10"></div>
</div>
<p class="mt-2 flex items-center justify-between font-mono text-[0.68rem] text-[var(--color-ink-3)]">
  <span class="truncate">{title} — {src}</span>
  <a href={src} target="_blank" rel="noreferrer" class="pointer-events-auto ml-3 shrink-0 underline hover:text-[var(--color-ink)]">open ↗</a>
</p>
